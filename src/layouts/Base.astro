---
interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Portfolio of Ethan — software engineer and agentic engineer.' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <nav>
        <a href="/" class="brand">CodeManEthan</a>
        <div class="nav-links">
          <a href="/#projects">Projects</a>
          <a href="/#about">About</a>
          <a href="https://github.com/CodeManEthan" target="_blank" rel="noopener">GitHub</a>
        </div>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>
        © {new Date().getFullYear()} Ethan · Built with Astro + Three.js ·
        <a href="https://github.com/CodeManEthan" target="_blank" rel="noopener">github.com/CodeManEthan</a>
      </p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #0b0e14;
    --bg-raised: #131722;
    --border: #232936;
    --text: #e6e9ef;
    --text-dim: #9aa3b2;
    --accent: #5eead4;
    --accent-2: #818cf8;
    --radius: 12px;
    --max-width: 1080px;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  a {
    color: var(--accent);
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
  }

  main {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 1.25rem;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
  }

  .site-header nav {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0.9rem 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .brand {
    font-weight: 700;
    color: var(--text);
    letter-spacing: 0.02em;
  }

  .nav-links {
    display: flex;
    gap: 1.5rem;
  }

  .nav-links a {
    color: var(--text-dim);
    font-size: 0.95rem;
  }

  .nav-links a:hover {
    color: var(--text);
    text-decoration: none;
  }

  .site-footer {
    border-top: 1px solid var(--border);
    margin-top: 5rem;
    padding: 2rem 1.25rem;
    text-align: center;
    color: var(--text-dim);
    font-size: 0.9rem;
  }

  code {
    font-family: 'JetBrains Mono', ui-monospace, 'Cascadia Code', Menlo, monospace;
    font-size: 0.9em;
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0.1em 0.35em;
  }

  pre {
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1rem;
    overflow-x: auto;
    margin: 1.25rem 0;
  }

  pre code {
    background: none;
    border: none;
    padding: 0;
  }
</style>
