---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, summary, tech, status, repo, demo, image, screenshot } = project.data;
const detailUrl = `/projects/${project.id}/`;
const art = image ?? screenshot;
const alt = image ? title : `${title} screenshot`;
const isGenesis = project.id === 'genesis';
---

<article class="card">
  <a href={detailUrl} class="thumb" tabindex="-1" aria-hidden="true">
    {art ? <img src={art} alt={alt} loading="lazy" width="1600" height="900" /> : <div class="panel"><span>{title}</span></div>}
  </a>
  <div class="card-body">
    <h3><a href={detailUrl}>{title}</a></h3>
    <p>{summary}</p>
    <ul class="chips" aria-label="Built with">
      {tech.map((t) => <li>{t}</li>)}
    </ul>
    <div class="card-links">
      <a href={detailUrl}>View</a>
      {status === 'public' && repo && (
        <a href={repo} target="_blank" rel="noopener">Source</a>
      )}
      {isGenesis ? (
        <a href="/genesis/">Open the valley</a>
      ) : (
        demo && <a href={demo} target="_blank" rel="noopener">Live demo</a>
      )}
      {status === 'private' && <span class="badge">Private</span>}
      {status === 'soon' && <span class="badge">Coming soon</span>}
    </div>
  </div>
</article>

<style>
  .card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition:
      transform 0.15s ease,
      border-color 0.15s ease;
  }

  .card:hover {
    transform: translateY(-2px);
    border-color: var(--teal);
  }

  @media (prefers-reduced-motion: reduce) {
    .card {
      transition: none;
    }
    .card:hover {
      transform: none;
    }
  }

  .thumb {
    display: block;
    aspect-ratio: 16 / 9;
    background: var(--bg);
    overflow: hidden;
  }

  .thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .panel {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    text-align: center;
  }

  .panel span {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.4rem, 2.4vw, 1.9rem);
    color: var(--ink);
    line-height: 1.15;
  }

  .card-body {
    padding: 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    flex: 1 1 auto;
  }

  h3 {
    font-size: 1.15rem;
  }

  h3 a {
    color: var(--ink);
  }

  .card-body p {
    color: var(--ink-soft);
    font-size: 0.92rem;
    flex: 1 1 auto;
  }

  .card-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    align-items: center;
    font-weight: 500;
    font-size: 0.9rem;
    margin-top: 0.2rem;
  }

  .badge {
    color: var(--ink-soft);
    font-size: 0.8rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.1rem 0.6rem;
  }
</style>
