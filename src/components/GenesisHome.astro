---
import { getCollection } from 'astro:content';
import TheGenesis from './designs/genesis/TheGenesis';
import { LOC, GEM_COLORS, fmtLoc } from '../data/islands';

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order
);

// Set on the design-lab preview URL so the duplicate of the homepage is not the
// copy search engines find. The homepage itself passes nothing.
interface Props {
  noindex?: boolean;
}
const { noindex = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {noindex && <meta name="robots" content="noindex" />}
    <meta
      name="description"
      content="Ethan — software engineer in Nashville, TN. Seven shipped projects, and a homepage valley that rebuilds itself from scratch every day, from nothing but the date."
    />
    <title>Ethan · Software Engineer — Nashville, TN</title>
  </head>
  <body>
    <a class="skip" href="#projects">Skip to the project list</a>

    <header class="topbar">
      <a class="wordmark" href="/">CodeManEthan</a>
      <nav>
        <a href="#projects">Projects</a>
        <a href="#about">About</a>
        <a href="https://github.com/CodeManEthan" target="_blank" rel="noopener">GitHub</a>
      </nav>
    </header>

    <section class="hero" aria-label="Today's valley — a pixel-art world generated from the date">
      <div class="hero-scene">
        <TheGenesis client:only="react" embed={true} />
      </div>

      <noscript>
        <div class="noscript">
          <p>
            The valley is generated in the browser and needs JavaScript. Every
            project is listed in plain form below.
          </p>
        </div>
      </noscript>
    </section>

    <main>
      <section class="intro" aria-label="Introduction">
        <p class="kicker">Nashville, TN</p>
        <h1>Hi, I&rsquo;m Ethan &mdash; software engineer.</h1>
        <p class="lead">
          I build software end to end &mdash; from a 68k-line personal finance
          platform to the agent infrastructure that lets LLMs do real work.
          Seven projects below, counting the valley above: this site generates a
          new world from scratch every day, from nothing but the date.
        </p>
        <div class="intro-actions">
          <a class="btn primary" href="#projects">See the projects &darr;</a>
          <a class="btn" href="#about">How the valley works</a>
        </div>
      </section>

      <section id="projects" class="projects">
        <h2>Seven projects</h2>
        <p class="section-sub">
          The world up there is weather, not a map of my work &mdash; its towns
          name themselves and none of them stand for anything. The work is here:
          seven projects, from a 68k-line finance app to a 2.3k-line
          notification fan-out &mdash; the last of them the world itself &mdash;
          with sources where the sources are mine to give.
        </p>
        <div class="grid">
          {
            projects.map((p, i) => {
              const loc = LOC[p.id];
              return (
                <article
                  class={`card${p.data.featured ? ' featured' : ''}`}
                  style={`--gem: ${GEM_COLORS[i % GEM_COLORS.length]}`}
                >
                  <div class="card-top">
                    <span class="gem-dot" aria-hidden="true" />
                    <h3>
                      <a href={`/projects/${p.id}/`}>{p.data.title}</a>
                    </h3>
                    {p.data.featured && <span class="badge">Featured</span>}
                  </div>
                  <p class="summary">{p.data.summary}</p>
                  {loc && <p class="size-line">{`${fmtLoc(loc)} lines`}</p>}
                  <ul class="tech">
                    {p.data.tech.map((t) => (
                      <li>{t}</li>
                    ))}
                  </ul>
                  <div class="card-links">
                    <a class="more" href={`/projects/${p.id}/`}>
                      View project →
                    </a>
                    {p.data.status === 'public' && p.data.repo && (
                      <a class="repo" href={p.data.repo} target="_blank" rel="noopener">
                        Source ↗
                      </a>
                    )}
                    {p.data.status === 'private' && (
                      <span class="status">Source private · demo on request</span>
                    )}
                    {p.data.status === 'soon' && <span class="status">Repo coming soon</span>}
                    {p.data.demo && (
                      <a class="repo" href={p.data.demo} target="_blank" rel="noopener">
                        Live demo ↗
                      </a>
                    )}
                  </div>
                </article>
              );
            })
          }
        </div>
      </section>

      <section id="about" class="about">
        <h2>A day is just a seed and a date</h2>
        <p>
          I&rsquo;m Ethan — a software engineer in Nashville, TN. I work across
          the stack: Python and Flask on the backend, React and TypeScript on
          the front, Bash and desktop automation where it counts. Lately my
          focus is agentic engineering — the durable plumbing that lets AI
          agents talk to each other and get real work done.
        </p>
        <p>
          The valley is not stored anywhere. Today&rsquo;s date is hashed into a
          seed, the seed generates the terrain, the river, the roads and every
          building the day will contain, and a timeline paces that build across
          twenty-four hours. Nothing is downloaded and nothing is remembered:
          give the same date to any browser on earth and you get the same valley,
          at the same hour, down to the cart on the bridge.
        </p>
        <p>
          Because the clock is your clock, the world you land on is the world your
          day has got to. Scrub it to watch the whole day in a few seconds, raise
          the <code>pace</code> to see how much more the same twenty-four hours
          could have held, or stay until midnight: the light goes, and the next
          date&rsquo;s valley comes up in its place on one house.
        </p>
        <p>
          The towns are the world&rsquo;s own. Their names come out of the same
          seed as their streets, and they are deliberately <em>not</em> project
          markers — I would rather the front door be a place than a diagram. The
          projects are in the grid above, where a link is a link.
        </p>
        <div class="about-actions">
          <a class="btn primary" href="mailto:codemanethan@gmail.com">
            codemanethan@gmail.com
          </a>
          <a class="btn" href="https://github.com/CodeManEthan" target="_blank" rel="noopener">
            github.com/CodeManEthan
          </a>
          <a class="btn" href="/days/">The days before &rarr;</a>
        </div>
      </section>
    </main>

    <footer>
      <p>© {new Date().getFullYear()} Ethan · Built with Astro, React &amp; a 2D canvas</p>
    </footer>
  </body>
</html>

<style is:global>
  /* The island's own chrome is React markup, so reaching it needs a global
     rule. The page's top bar owns the first strip of the hero; the island's
     corner column starts underneath it rather than fighting the nav. */
  .gen-embed .gen-corner {
    top: 3.6rem;
  }

  @media (max-width: 820px) {
    /* The band starts below the bar already, so the corner goes back to the
       top of the world. */
    .gen-embed .gen-corner {
      top: 10px;
    }
  }
</style>

<style>
  :root {
    --cream: #fdf8ef;
    --card: #ffffff;
    --ink: #413a55;
    --ink-soft: #7a7690;
    --border: #ece3d2;
    --mint: #63c9a8;
  }

  html {
    scroll-behavior: smooth;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }

  body {
    margin: 0;
    background: var(--cream);
    color: var(--ink);
    font-family:
      system-ui,
      -apple-system,
      'Segoe UI',
      Roboto,
      'Helvetica Neue',
      sans-serif;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .skip {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 20;
    padding: 0.6rem 1rem;
    background: var(--mint);
    color: #12483a;
    font-weight: 800;
    border-radius: 0 0 8px 0;
  }

  .skip:focus {
    left: 0;
  }

  /* ------------------------------- top bar ------------------------------ */

  .topbar {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 8;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.9rem clamp(0.9rem, 3vw, 2.4rem);
    background: linear-gradient(180deg, rgba(253, 248, 239, 0.92), rgba(253, 248, 239, 0));
  }

  .wordmark {
    font-weight: 800;
    font-size: 1.05rem;
  }

  .topbar nav {
    display: flex;
    gap: 1.2rem;
  }

  .topbar nav a {
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--ink-soft);
    transition: color 0.15s ease;
  }

  .topbar nav a:hover {
    color: var(--ink);
  }

  /* --------------------------------- hero ------------------------------- */

  .hero {
    position: relative;
    min-height: 100svh;
    overflow: hidden;
    background: #3f7f66;
  }

  .hero-scene {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  /* The world owns the whole first screen; the introduction is the first
     section under it. */
  .intro {
    margin-bottom: 3.2rem;
  }

  .kicker {
    margin: 0 0 0.28rem;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #2f8f74;
  }

  h1 {
    margin: 0 0 0.55rem;
    font-size: clamp(2rem, 4.4vw, 2.7rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .lead {
    margin: 0 0 1.2rem;
    max-width: 44rem;
    color: #5c5877;
    font-size: 1.05rem;
  }

  .intro-actions,
  .about-actions {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-block;
    padding: 0.45rem 1rem;
    border-radius: 999px;
    font-weight: 700;
    font-size: 0.87rem;
    border: 2px solid var(--ink);
    background: #ffffff;
    color: var(--ink);
    transition:
      transform 0.14s ease,
      box-shadow 0.14s ease;
    box-shadow: 0 3px 0 rgba(65, 58, 85, 0.25);
  }

  .btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 5px 0 rgba(65, 58, 85, 0.25);
  }

  .btn.primary {
    background: var(--mint);
    color: #12483a;
  }

  /* On a phone the valley is a wide landscape in a tall portrait window, so the
     first screen becomes a world band with the introduction right below it. */
  @media (max-width: 820px) {
    .hero {
      min-height: 0;
      padding-top: 3.5rem;
      background: var(--cream);
    }

    .hero-scene {
      position: relative;
      inset: auto;
      height: 48svh;
      min-height: 330px;
    }

    .lead {
      font-size: 0.95rem;
    }

    .noscript {
      position: static;
      padding: 2rem 1rem;
      color: var(--ink-soft);
    }

    .topbar {
      padding: 0.7rem 0.8rem;
    }

    .topbar nav {
      gap: 0.8rem;
      font-size: 0.82rem;
    }
  }

  @media (max-width: 430px) {
    .wordmark {
      font-size: 0.92rem;
    }

    .topbar nav {
      gap: 0.6rem;
      font-size: 0.76rem;
    }
  }

  .noscript {
    position: absolute;
    inset: auto 0 40% 0;
    z-index: 5;
    text-align: center;
    color: #fffdf6;
  }

  /* -------------------------------- main -------------------------------- */

  main {
    max-width: 68rem;
    margin: 0 auto;
    padding: 4.2rem 1.4rem 2rem;
  }

  h2 {
    margin: 0 0 0.5rem;
    font-size: clamp(1.5rem, 3vw, 2rem);
    letter-spacing: -0.01em;
  }

  .section-sub {
    margin: 0 0 2rem;
    max-width: 46rem;
    color: var(--ink-soft);
  }

  code {
    font-size: 0.86em;
    padding: 0.05rem 0.3rem;
    border-radius: 5px;
    background: #f2ece0;
    color: #5c5877;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
    gap: 1.3rem;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    background: var(--card);
    border: 2px solid var(--border);
    border-radius: 16px;
    padding: 1.2rem 1.3rem;
    transition:
      transform 0.16s ease,
      border-color 0.16s ease,
      box-shadow 0.16s ease;
  }

  .card:hover {
    transform: translateY(-3px);
    border-color: var(--gem);
    box-shadow: 0 10px 26px rgba(65, 58, 85, 0.1);
  }

  .card.featured {
    border-color: color-mix(in srgb, var(--gem) 45%, var(--border));
  }

  .card-top {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .gem-dot {
    width: 10px;
    height: 10px;
    border-radius: 3px;
    background: var(--gem);
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--gem) 25%, transparent);
    flex: none;
  }

  .card h3 {
    margin: 0;
    font-size: 1.1rem;
  }

  .card h3 a:hover {
    color: var(--gem);
  }

  .badge {
    margin-left: auto;
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .summary {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.92rem;
    flex: 1;
  }

  .size-line {
    margin: 0;
    font-size: 0.78rem;
    font-weight: 700;
    color: color-mix(in srgb, var(--gem) 65%, var(--ink));
  }

  .tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tech li {
    font-size: 0.72rem;
    padding: 0.1rem 0.55rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--ink-soft);
  }

  .card-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.8rem;
    font-size: 0.85rem;
    margin-top: 0.2rem;
  }

  .more {
    font-weight: 700;
    color: color-mix(in srgb, var(--gem) 70%, var(--ink));
  }

  .repo {
    color: var(--ink-soft);
    font-weight: 600;
  }

  .status {
    font-size: 0.74rem;
    color: var(--ink-soft);
    border: 1px dashed var(--border);
    border-radius: 999px;
    padding: 0.05rem 0.55rem;
  }

  /* -------------------------------- about ------------------------------- */

  .about {
    margin-top: 4.5rem;
    max-width: 46rem;
  }

  .about p {
    color: var(--ink-soft);
    margin: 0 0 1rem;
  }

  footer {
    border-top: 2px solid var(--border);
    margin-top: 4rem;
    padding: 1.5rem 1.4rem 2.2rem;
    text-align: center;
    color: var(--ink-soft);
    font-size: 0.85rem;
  }

  footer p {
    margin: 0;
  }
</style>
