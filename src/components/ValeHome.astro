---
import { getCollection } from 'astro:content';
import TheVale from './designs/vale/TheVale';
import { fmtLoc, villageSize, type WorldState } from './designs/vale/worldstate';
import { LOC, GEM_COLORS } from '../data/islands';
import worldJson from '../data/world.json';

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order
);

// The committed world.json IS the vale — the canvas renders it and this page
// reads straight out of it, so a patch to the file changes both. Reseed with
// `node scripts/build-world.mjs` (destructive: discards accumulated patches).
const world = worldJson as unknown as WorldState;
const byId = new Map(world.villages.map((v) => [v.id, v]));
const ledger = world.buildLog.slice(-8).reverse();
const totalBuildings = world.villages.reduce((n, v) => n + v.buildings.length, 0);
const inProgress = world.villages
  .flatMap((v) => v.buildings.map((b) => ({ v, b })))
  .filter(({ b }) => b.progress < 1);
const villageName = (id: string) => byId.get(id)?.name ?? id;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Ethan — software engineer & agentic engineer. A pixel-art vale where every project is its own village, sized by its real codebase, with carts on the roads between them and a timber town going up at the frontier."
    />
    <title>Ethan · Software &amp; Agentic Engineer — The Vale</title>
  </head>
  <body>
    <a class="skip" href="#projects">Skip to the project list</a>

    <header class="topbar">
      <a class="wordmark" href="/">CodeManEthan</a>
      <nav>
        <a href="#projects">Projects</a>
        <a href="#ledger">Ledger</a>
        <a href="#about">About</a>
        <a href="https://github.com/CodeManEthan" target="_blank" rel="noopener">GitHub</a>
      </nav>
    </header>

    <section class="hero" aria-label="The Vale — a pixel-art map of Ethan's projects">
      <div class="hero-scene">
        <TheVale client:only="react" />
      </div>

      <div class="hero-copy">
        <p class="kicker">Welcome to the vale</p>
        <h1>Hi, I&rsquo;m Ethan.</h1>
        <p class="tagline">
          Software engineer &amp; agentic engineer. Every village down there is
          one of my projects &mdash; sized by its real codebase, joined by roads
          the carts actually run on, and there&rsquo;s a timber town going up at
          the south-west frontier.
        </p>
        <div class="hero-actions">
          <a class="btn primary" href="#projects">Skip to the project list &darr;</a>
          <a class="btn" href="mailto:codemanethan@gmail.com">Say hello</a>
        </div>
        <p class="hero-note">
          {world.villages.length} villages · {totalBuildings} buildings · {world.travelers.length}
          {' '}carts and walkers on the roads
        </p>
      </div>

      <noscript>
        <div class="noscript">
          <p>
            The vale needs JavaScript to render. Every project is listed in plain
            form below.
          </p>
        </div>
      </noscript>
    </section>

    <main>
      <section id="projects" class="projects">
        <h2>Seven projects, seven villages</h2>
        <p class="section-sub">
          Village size follows the cube root of each repo&rsquo;s line count, so
          a 68k-line app becomes a proper town of eleven buildings while a
          1.7k-line one is a two-cottage hamlet &mdash; twice the size, not forty
          times. Each village&rsquo;s landmark building is picked from its actual
          stack. Same content as the map, no canvas required.
        </p>
        <div class="grid">
          {
            projects.map((p, i) => {
              const v = byId.get(p.id);
              const loc = LOC[p.id] ?? 2000;
              const site = v && v.buildings.some((b) => b.progress < 1);
              return (
                <article
                  class={`card${p.data.featured ? ' featured' : ''}`}
                  style={`--gem: ${GEM_COLORS[i % GEM_COLORS.length]}`}
                >
                  <div class="card-top">
                    <span class="gem-dot" aria-hidden="true" />
                    <h3>
                      <a href={`/projects/${p.id}/`}>{p.data.title}</a>
                    </h3>
                    {p.data.featured && <span class="badge">Featured</span>}
                  </div>
                  <p class="summary">{p.data.summary}</p>
                  <p class="size-line">
                    {`${fmtLoc(loc)} lines · ${villageSize(loc)} of ${v ? v.buildings.length : 0} buildings`}
                    {site && ' · one still under scaffold'}
                  </p>
                  <ul class="tech">
                    {p.data.tech.map((t) => (
                      <li>{t}</li>
                    ))}
                  </ul>
                  <div class="card-links">
                    <a class="more" href={`/projects/${p.id}/`}>
                      View project →
                    </a>
                    {p.data.status === 'public' && p.data.repo && (
                      <a class="repo" href={p.data.repo} target="_blank" rel="noopener">
                        Source ↗
                      </a>
                    )}
                    {p.data.status === 'private' && (
                      <span class="status">Source private · demo on request</span>
                    )}
                    {p.data.status === 'soon' && <span class="status">Repo coming soon</span>}
                    {p.data.demo && (
                      <a class="repo" href={p.data.demo} target="_blank" rel="noopener">
                        Live demo ↗
                      </a>
                    )}
                  </div>
                </article>
              );
            })
          }
        </div>
      </section>

      <section id="ledger" class="ledger">
        <h2>The vale ledger</h2>
        <p class="section-sub">
          The map is not drawn by hand &mdash; it is rendered from a plain,
          serialisable world object: terrain chunks, the river, the road network,
          every building with its own <code>progress</code> and
          <code>condition</code>, the traveller routes, and this log. Nothing in
          the renderer invents content, so a scheduled agent can patch the world
          the same way a person would edit a file.
        </p>
        <ol class="log">
          {
            ledger.map((e) => (
              <li>
                <span class="day">day {e.day}</span>
                <span class="where">{villageName(e.village)}</span>
                <span class="what">{e.text}</span>
              </li>
            ))
          }
        </ol>
        <div class="growth">
          <h3>Under construction right now</h3>
          <ul>
            {
              inProgress.map(({ v, b }) => (
                <li>
                  <span class="pip" style={`--gem: ${v.accent}`} />
                  <strong>{b.label}</strong> at {v.name} —
                  <span class="bar" aria-hidden="true">
                    <i style={`width: ${Math.round(b.progress * 100)}%; background: ${v.accent}`} />
                  </span>
                  <span class="pct">{Math.round(b.progress * 100)}%</span>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <section id="about" class="about">
        <h2>The homestead at the crossroads</h2>
        <p>
          I&rsquo;m Ethan — a software engineer and agentic engineer. I work
          across the stack: Python and Flask on the backend, React and TypeScript
          on the front, Bash and desktop automation where it counts. Lately my
          focus is agent infrastructure — the durable plumbing that lets AI
          agents talk to each other and get work done.
        </p>
        <p>
          The vale is drawn from scratch: no game engine, no sprite sheets, no
          3D. The whole countryside is rasterised once into a buffer where one
          unit is one art pixel, and the camera blits the slice you are looking
          at in whole-pixel steps, which is why the edges stay hard at every
          zoom. The villagers, the carts between villages and the mill wheel are
          painted on top each frame, and the few pieces of scenery that should
          stand in front of them are folded back into the same depth-sorted pass.
        </p>
        <p>
          The point of the exercise is the layer underneath: the world is data,
          not drawing code. Timberfoot, still going up at the frontier, is not a
          decoration — the vale grows on its own story rather than on my commit
          history, and every <code>progress</code> in it is a number an agent
          raises.
        </p>
        <div class="about-actions">
          <a class="btn primary" href="mailto:codemanethan@gmail.com">
            codemanethan@gmail.com
          </a>
          <a class="btn" href="https://github.com/CodeManEthan" target="_blank" rel="noopener">
            github.com/CodeManEthan
          </a>
        </div>
      </section>
    </main>

    <footer>
      <p>© {new Date().getFullYear()} Ethan · Built with Astro, React &amp; a 2D canvas</p>
    </footer>
  </body>
</html>

<style is:global>
  /* ---- the canvas island's own chrome (React markup, so global) ---- */

  .vl-wrap {
    position: absolute;
    inset: 0;
    overflow: hidden;
    cursor: grab;
    /* Vertical page scrolling always wins; horizontal drags roam the map. */
    touch-action: pan-y;
    outline: none;
  }

  .vl-wrap:active {
    cursor: grabbing;
  }

  .vl-wrap:focus-visible {
    box-shadow: inset 0 0 0 3px rgba(99, 201, 168, 0.85);
  }

  .vl-canvas {
    position: absolute;
    left: 0;
    top: 0;
    display: block;
    image-rendering: pixelated;
    image-rendering: crisp-edges;
  }

  .vl-hits {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .vl-hit {
    position: absolute;
    left: 0;
    top: 0;
    display: block;
    pointer-events: auto;
    border-radius: 8px;
    cursor: pointer;
    -webkit-user-drag: none;
    outline-offset: 3px;
  }

  .vl-hit:focus-visible {
    outline: 3px solid #fffdf6;
    background: rgba(255, 255, 255, 0.14);
  }

  .vl-pill {
    position: absolute;
    left: 50%;
    bottom: -6px;
    transform: translateX(-50%);
    display: inline-flex;
    align-items: center;
    gap: 0.32rem;
    padding: 0.08rem 0.46rem;
    border-radius: 999px;
    background: rgba(255, 253, 246, 0.9);
    border: 1px solid rgba(65, 58, 85, 0.28);
    box-shadow: 0 2px 0 rgba(65, 58, 85, 0.18);
    color: #413a55;
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.03em;
    white-space: nowrap;
    pointer-events: none;
    transition: background 0.12s ease;
  }

  .vl-pill i {
    width: 7px;
    height: 7px;
    border-radius: 2px;
    flex: none;
    box-shadow: 0 0 0 1px rgba(65, 58, 85, 0.3);
  }

  .vl-hit:hover .vl-pill,
  .vl-hit:focus-visible .vl-pill {
    background: #fffdf6;
    border-color: var(--gem, #413a55);
  }

  /* Zoomed right out, the names would pile up: leave only the gem dots. */
  .vl-hit[data-compact='1'] .vl-pill b {
    display: none;
  }

  .vl-hit[data-compact='1'] .vl-pill {
    padding: 0.14rem;
    gap: 0;
  }

  .vl-homestead .vl-pill {
    border-color: #2f8f74;
    background: #fffdf6;
  }

  .vl-frontier .vl-pill {
    border-style: dashed;
  }

  .vl-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .vl-tip {
    position: absolute;
    left: 0;
    top: 0;
    margin-top: -12px;
    min-width: 10rem;
    max-width: 16rem;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    padding: 0.5rem 0.72rem;
    background: rgba(255, 253, 246, 0.97);
    border: 2px solid #413a55;
    border-radius: 10px;
    box-shadow: 0 10px 26px rgba(65, 58, 85, 0.22);
    pointer-events: none;
    z-index: 6;
    translate: -50% -100%;
  }

  .vl-tip[data-below='1'] {
    margin-top: 12px;
    translate: -50% 0;
  }

  .vl-tip strong {
    font-size: 0.94rem;
    line-height: 1.25;
  }

  .vl-tip-meta {
    font-size: 0.71rem;
    font-weight: 700;
    color: #7a7690;
  }

  .vl-tip-tech {
    font-size: 0.68rem;
    color: #9a95ad;
    line-height: 1.35;
  }

  .vl-tip-cta {
    margin-top: 0.28rem;
    font-size: 0.7rem;
    font-weight: 800;
    color: #2f8f74;
  }

  /* Zoom controls stacked above the minimap in one bottom-right column, so the
     column can never overlap itself however tall the minimap comes out. */
  .vl-corner {
    position: absolute;
    right: 0.9rem;
    bottom: 0.9rem;
    z-index: 5;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.45rem;
  }

  .vl-mini {
    padding: 5px 5px 3px;
    border-radius: 8px;
    background: rgba(255, 253, 246, 0.86);
    border: 2px solid rgba(65, 58, 85, 0.55);
    box-shadow: 0 6px 18px rgba(65, 58, 85, 0.22);
  }

  .vl-mini canvas {
    display: block;
    image-rendering: pixelated;
    image-rendering: crisp-edges;
    border-radius: 3px;
    cursor: crosshair;
  }

  .vl-mini-cap {
    display: block;
    padding-top: 2px;
    text-align: center;
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #7a7690;
  }

  .vl-controls {
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }

  .vl-controls button {
    width: 30px;
    height: 30px;
    display: grid;
    place-items: center;
    font: inherit;
    font-size: 1rem;
    font-weight: 800;
    color: #413a55;
    background: rgba(255, 253, 246, 0.9);
    border: 2px solid rgba(65, 58, 85, 0.55);
    border-radius: 7px;
    cursor: pointer;
    line-height: 1;
  }

  .vl-controls button.vl-fit {
    width: auto;
    padding: 0 0.55rem;
    font-size: 0.74rem;
  }

  .vl-controls button:hover {
    background: #fffdf6;
    border-color: #2f8f74;
  }

  .vl-zoomread {
    min-width: 3.6rem;
    max-width: 5.5rem;
    white-space: nowrap;
    overflow: hidden;
    padding: 0.1rem 0.4rem;
    border-radius: 999px;
    background: rgba(255, 253, 246, 0.8);
    text-align: center;
    font-size: 0.66rem;
    font-weight: 800;
    color: #7a7690;
  }

  .vl-hint {
    position: absolute;
    left: 0.9rem;
    bottom: 1rem;
    z-index: 5;
    margin: 0;
    padding: 0.26rem 0.8rem;
    border-radius: 999px;
    background: rgba(255, 253, 246, 0.72);
    border: 1px solid rgba(65, 58, 85, 0.14);
    color: #6b6684;
    font-size: 0.72rem;
    pointer-events: none;
  }

  @media (max-width: 820px) {
    .vl-hint {
      display: none;
    }

    .vl-corner {
      right: 0.5rem;
      bottom: 0.5rem;
      transform: scale(0.8);
      transform-origin: bottom right;
    }

    /* In the small map band there is no corner free of villages, and at the
       fitted overview the minimap only repeats what is already on screen — so
       it steps aside until the visitor zooms in and actually needs it. */
    .vl-wrap[data-zoom='fit'] .vl-mini {
      display: none;
    }
  }

  @media (max-width: 560px) {
    .vl-corner {
      transform: scale(0.68);
    }

    .vl-mini-cap {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .vl-hint {
      display: none;
    }
  }
</style>

<style>
  :root {
    --cream: #fdf8ef;
    --card: #ffffff;
    --ink: #413a55;
    --ink-soft: #7a7690;
    --border: #ece3d2;
    --mint: #63c9a8;
  }

  html {
    scroll-behavior: smooth;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }

  body {
    margin: 0;
    background: var(--cream);
    color: var(--ink);
    font-family:
      system-ui,
      -apple-system,
      'Segoe UI',
      Roboto,
      'Helvetica Neue',
      sans-serif;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .skip {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 20;
    padding: 0.6rem 1rem;
    background: var(--mint);
    color: #12483a;
    font-weight: 800;
    border-radius: 0 0 8px 0;
  }

  .skip:focus {
    left: 0;
  }

  /* ------------------------------- top bar ------------------------------ */

  .topbar {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 8;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.9rem clamp(0.9rem, 3vw, 2.4rem);
    background: linear-gradient(180deg, rgba(253, 248, 239, 0.92), rgba(253, 248, 239, 0));
  }

  .wordmark {
    font-weight: 800;
    font-size: 1.05rem;
  }

  .topbar nav {
    display: flex;
    gap: 1.2rem;
  }

  .topbar nav a {
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--ink-soft);
    transition: color 0.15s ease;
  }

  .topbar nav a:hover {
    color: var(--ink);
  }

  /* --------------------------------- hero ------------------------------- */

  .hero {
    position: relative;
    min-height: 100svh;
    overflow: hidden;
    background: #3f7f66;
  }

  .hero-scene {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .hero-copy {
    position: absolute;
    z-index: 4;
    left: clamp(0.9rem, 3vw, 2.4rem);
    top: 4.4rem;
    width: min(24rem, calc(100% - 2rem));
    padding: 1.1rem 1.25rem 1rem;
    border-radius: 14px;
    background: rgba(253, 248, 239, 0.93);
    border: 2px solid rgba(65, 58, 85, 0.5);
    box-shadow: 0 12px 30px rgba(30, 46, 40, 0.28);
  }

  .kicker {
    margin: 0 0 0.28rem;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #2f8f74;
  }

  h1 {
    margin: 0 0 0.4rem;
    font-size: clamp(1.7rem, 3.4vw, 2.3rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .tagline {
    margin: 0 0 0.9rem;
    color: #5c5877;
    font-size: 0.93rem;
  }

  .hero-actions,
  .about-actions {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .hero-note {
    margin: 0.85rem 0 0;
    padding-top: 0.7rem;
    border-top: 1px dashed var(--border);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--ink-soft);
  }

  .btn {
    display: inline-block;
    padding: 0.45rem 1rem;
    border-radius: 999px;
    font-weight: 700;
    font-size: 0.87rem;
    border: 2px solid var(--ink);
    background: #ffffff;
    color: var(--ink);
    transition:
      transform 0.14s ease,
      box-shadow 0.14s ease;
    box-shadow: 0 3px 0 rgba(65, 58, 85, 0.25);
  }

  .btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 5px 0 rgba(65, 58, 85, 0.25);
  }

  .btn.primary {
    background: var(--mint);
    color: #12483a;
  }

  /* On a phone the vale is a wide landscape in a tall portrait window, so the
     hero stops being an overlay: the copy sits above a map band instead of
     floating over a screenful of forest. */
  @media (max-width: 820px) {
    .hero {
      min-height: 0;
      padding-top: 3.5rem;
      background: var(--cream);
    }

    .hero-scene {
      position: relative;
      inset: auto;
      height: 48svh;
      min-height: 330px;
    }

    .hero-copy {
      position: static;
      width: auto;
      margin: 0 0.8rem 0.8rem;
      padding: 0.9rem 1rem;
      box-shadow: none;
      border-width: 2px;
    }

    .tagline {
      font-size: 0.86rem;
      margin-bottom: 0.75rem;
    }

    .hero-note {
      display: none;
    }

    .noscript {
      position: static;
      padding: 2rem 1rem;
      color: var(--ink-soft);
    }

    .topbar {
      padding: 0.7rem 0.8rem;
    }

    .topbar nav {
      gap: 0.8rem;
      font-size: 0.82rem;
    }
  }

  @media (max-width: 430px) {
    .wordmark {
      font-size: 0.92rem;
    }

    .topbar nav {
      gap: 0.6rem;
      font-size: 0.76rem;
    }
  }

  .noscript {
    position: absolute;
    inset: auto 0 40% 0;
    z-index: 5;
    text-align: center;
    color: #fffdf6;
  }

  /* -------------------------------- main -------------------------------- */

  main {
    max-width: 68rem;
    margin: 0 auto;
    padding: 4.2rem 1.4rem 2rem;
  }

  h2 {
    margin: 0 0 0.5rem;
    font-size: clamp(1.5rem, 3vw, 2rem);
    letter-spacing: -0.01em;
  }

  .section-sub {
    margin: 0 0 2rem;
    max-width: 46rem;
    color: var(--ink-soft);
  }

  code {
    font-size: 0.86em;
    padding: 0.05rem 0.3rem;
    border-radius: 5px;
    background: #f2ece0;
    color: #5c5877;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
    gap: 1.3rem;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    background: var(--card);
    border: 2px solid var(--border);
    border-radius: 16px;
    padding: 1.2rem 1.3rem;
    transition:
      transform 0.16s ease,
      border-color 0.16s ease,
      box-shadow 0.16s ease;
  }

  .card:hover {
    transform: translateY(-3px);
    border-color: var(--gem);
    box-shadow: 0 10px 26px rgba(65, 58, 85, 0.1);
  }

  .card.featured {
    border-color: color-mix(in srgb, var(--gem) 45%, var(--border));
  }

  .card-top {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .gem-dot {
    width: 10px;
    height: 10px;
    border-radius: 3px;
    background: var(--gem);
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--gem) 25%, transparent);
    flex: none;
  }

  .card h3 {
    margin: 0;
    font-size: 1.1rem;
