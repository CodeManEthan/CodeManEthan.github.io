---
import fs from 'node:fs';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const hasNotes = (await getCollection('notes', ({ data }) => !data.draft)).length > 0;
const headshot = fs.existsSync('public/headshot.png');

const title = 'Ethan Plunk · Software developer, Nashville';
const description =
  'Software developer. Full-stack apps, Linux tooling, and the multi-agent harness I built to ship them faster.';
---

<Base title={title} description={description}>
  <section class="hero">
    <div class="hero-text">
      <p class="kicker">Nashville, TN</p>
      <span class="bar" aria-hidden="true"></span>
      <h1>Ethan Plunk</h1>
      <p class="subline">
        Software developer. Full-stack apps, Linux tooling, and the multi-agent harness I built to
        ship them faster.
      </p>
      <p class="lead">
        Most of what's here I built by directing AI coding agents, and the harness that makes that
        work is the project I spend the most time on. The rest is the apps, tools and simulations
        it helped me ship.
      </p>
      <ul class="chips" aria-label="Languages">
        <li>Python</li>
        <li>TypeScript</li>
        <li>Linux</li>
      </ul>
      <div class="actions">
        <a class="btn primary" href="#projects">Projects</a>
        {hasNotes ? (
          <a class="btn" href="/notes/">Notes</a>
        ) : (
          <a class="btn" href="https://www.linkedin.com/in/j-ethan-plunk" target="_blank" rel="noopener">LinkedIn</a>
        )}
      </div>
    </div>
    {headshot && (
      <div class="hero-photo">
        <img src="/headshot.png" alt="Ethan Plunk" width="340" height="425" />
      </div>
    )}
  </section>

  <section id="projects" class="projects">
    <h2>Projects</h2>
    <p class="section-line">
      Live demos where there's a demo, source where the source is mine to give, and write-ups for
      the work that stays private.
    </p>
    <div class="grid">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>

  <section id="about" class="about">
    <h2>About</h2>
    <p>
      I'm a software developer in Nashville. I started coding in 2023 with VBA automations in
      Excel, using early ChatGPT as a tutor, and moved to Python, Bash and Linux in late 2024. Most
      of what I've built since then, I built by directing coding agents.
    </p>
    <p>
      My main project is a harness for working with AI coding agents, the tooling that sits around
      Claude Code and Codex. The point is to take the friction out of working with coding agents.
      Reliability, structure and good practice live in the tooling instead of in my discipline.
    </p>
    <p>
      I'm not tied to one language. I've worked in Python, Bash, SQL and JavaScript and pick up
      what a job needs. Where I add the most is on a team working out how to put AI agents to
      work, in Nashville or remote. I also help local businesses do the same.
    </p>
  </section>

  <section class="contact" aria-label="Contact">
    <div class="actions">
      <a class="btn primary" href="mailto:j.ethan.plunk@gmail.com">j.ethan.plunk@gmail.com</a>
      <a class="btn" href="https://github.com/CodeManEthan" target="_blank" rel="noopener">GitHub</a>
      <a class="btn" href="https://www.linkedin.com/in/j-ethan-plunk" target="_blank" rel="noopener">LinkedIn</a>
      <a class="btn" href="https://twitch.tv/codemanethan" target="_blank" rel="noopener">Twitch</a>
    </div>
  </section>
</Base>

<style>
  .hero {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2.5rem;
    padding: 3.6rem 0 3rem;
  }

  .hero-text {
    max-width: 40rem;
  }

  .kicker {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--teal);
    margin-bottom: 0.9rem;
  }

  .bar {
    display: block;
    width: 3rem;
    height: 4px;
    background: var(--teal);
    border-radius: 2px;
    margin-bottom: 0.9rem;
  }

  .subline {
    font-size: 1.2rem;
    font-weight: 500;
    margin-top: 0.8rem;
  }

  .lead {
    color: var(--ink-soft);
    margin-top: 0.9rem;
  }

  .hero .chips {
    margin-top: 1.1rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.4rem;
  }

  .hero-photo {
    flex: 0 0 auto;
  }

  .hero-photo img {
    display: block;
    width: 340px;
    height: 425px;
    border-radius: 14px;
    border: 3px solid var(--teal);
    object-fit: cover;
  }

  .projects,
  .about {
    padding-top: 2rem;
    scroll-margin-top: 4rem;
  }

  .section-line {
    color: var(--ink-soft);
    margin: 0.5rem 0 1.4rem;
    max-width: 46rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.1rem;
  }

  .about {
    max-width: 46rem;
    margin-top: 3rem;
  }

  .about p {
    margin-top: 0.9rem;
  }

  .contact {
    margin-top: 2rem;
  }

  @media (max-width: 820px) {
    .hero {
      flex-direction: column;
      align-items: flex-start;
      padding-top: 2.6rem;
    }
    .hero-photo {
      display: none;
    }
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 480px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
