---
/**
 * The Seven Charters — DESIGN LAB, DEV ONLY.
 *
 * A candidate homepage. The valley is still the front door and the projects are
 * still a grid of cards; what changes is what a card is made of. Every card is
 * a live evening render of that project's own village — a real canvas world,
 * generated in the browser from the project's slug and sized by its line count
 * — so the page is one big world over seven small ones, all in the same hand.
 *
 * Fenced off exactly like /catalog, and for the same two reasons:
 *
 *  1. `getStaticPaths` hands back one path under `astro dev` and none at all in
 *     a build, so the page is never emitted.
 *  2. Both React islands are mounted by hand from an `import.meta.env.DEV`
 *     branch rather than with `client:only`. Vite folds that flag to `false` in
 *     a build and drops the branch; a `client:only` directive would instead
 *     leave an orphan chunk in dist/_astro for a page that does not exist.
 */
import { getCollection } from 'astro:content';
import { LOC, GEM_COLORS, fmtLoc, sizeLabel } from '../../../data/islands';

export function getStaticPaths() {
  return import.meta.env.DEV ? [{ params: { slug: undefined } }] : [];
}

const ROMAN = ['I', 'II', 'III', 'IV', 'V', 'VI', 'VII', 'VIII', 'IX', 'X'];

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

/** Everything a card needs, resolved on the server: the island only ever adds
 * the world. */
const charters = projects.map((p, i) => {
  const loc = LOC[p.id] ?? 0;
  return {
    slug: p.id,
    title: p.data.title,
    summary: p.data.summary,
    tech: p.data.tech,
    status: p.data.status,
    featured: p.data.featured,
    repo: p.data.repo,
    demo: p.data.demo,
    loc,
    accent: GEM_COLORS[i % GEM_COLORS.length],
    numeral: ROMAN[i] ?? String(i + 1),
    locLabel: fmtLoc(loc),
    sizeLabel: sizeLabel(loc),
  };
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta
      name="description"
      content="Ethan — software engineer in Nashville, TN. Seven shipped projects, each one drawn as its own village, and a homepage valley that rebuilds itself from scratch every day."
    />
    <title>Ethan · Software Engineer — Nashville, TN</title>
  </head>
  <body>
    <a class="skip" href="#projects">Skip to the project list</a>

    <header class="topbar">
      <a class="wordmark" href="/">CodeManEthan</a>
      <nav>
        <a href="#projects">Projects</a>
        <a href="#about">About</a>
        <a href="https://github.com/CodeManEthan" target="_blank" rel="noopener">GitHub</a>
      </nav>
    </header>

    <section class="hero" aria-label="Today's valley — a pixel-art world generated from the date">
      <div class="hero-scene" id="hero-root"></div>

      <noscript>
        <div class="noscript">
          <p>
            The valley is generated in the browser and needs JavaScript. Every
            project is listed in plain form below.
          </p>
        </div>
      </noscript>
    </section>

    <main>
      <section class="intro" aria-label="Introduction">
        <p class="kicker">Nashville, TN</p>
        <h1>Hi, I&rsquo;m Ethan &mdash; software engineer.</h1>
        <p class="lead">
          I build software end to end &mdash; from a 68k-line personal finance
          platform to the agent infrastructure that lets LLMs do real work.
          Seven projects below, counting the valley above: this site generates a
          new world from scratch every day, from nothing but the date.
        </p>
        <div class="intro-actions">
          <a class="btn primary" href="#projects">See the projects &darr;</a>
          <a class="btn" href="#about">How the valley works</a>
        </div>
      </section>

      <section id="projects" class="projects">
        <h2>The seven charters</h2>
        <p class="section-sub">
          The world up there is one day of one valley. Below it are seven more,
          and these ones do stand for something: each card is a village
          generated from its project&rsquo;s name and built out to the size of
          its real source &mdash; a couple of roofs for a 2.3k-line library, a
          settled valley of eleven towns for a 68k-line app. They are not
          pictures. Every one of them is drawn in this browser, from scratch, at
          half past eight in the evening.
        </p>

        <div id="charters-root"></div>

        <noscript>
          <p class="noscript-note">
            The villages are generated in the browser, so they need JavaScript.
            The projects themselves do not &mdash; here they are in plain form.
          </p>
          <ul class="plain">
            {
              charters.map((c) => (
                <li>
                  <a href={`/projects/${c.slug}/`}>{c.title}</a>
                  <span> &mdash; {c.summary}</span>
                  {c.loc > 0 && <span class="plain-loc"> ({c.locLabel} lines)</span>}
                  {c.status === 'public' && c.repo && (
                    <span>
                      {' · '}
                      <a href={c.repo} rel="noopener">
                        Source
                      </a>
                    </span>
                  )}
                  {c.demo && (
                    <span>
                      {' · '}
                      <a href={c.demo} rel="noopener">
                        Live demo
                      </a>
                    </span>
                  )}
                </li>
              ))
            }
          </ul>
        </noscript>
      </section>

      <section id="about" class="about">
        <h2>A day is just a seed and a date</h2>
        <p>
          I&rsquo;m Ethan — a software engineer in Nashville, TN. I work across
          the stack: Python and Flask on the backend, React and TypeScript on
          the front, Bash and desktop automation where it counts. Lately my
          focus is agentic engineering — the durable plumbing that lets AI
          agents talk to each other and get real work done.
        </p>
        <p>
          The valley at the top is not stored anywhere. Today&rsquo;s date is
          hashed into a seed, the seed generates the terrain, the river, the
          roads and every building the day will contain, and a timeline paces
          that build across twenty-four hours. Nothing is downloaded and nothing
          is remembered: give the same date to any browser on earth and you get
          the same valley, at the same hour, down to the cart on the bridge.
        </p>
        <p>
          The seven villages are the same machine pointed at a different
          question. A charter&rsquo;s seed is its project&rsquo;s name rather
          than the date, so it is the same village every day forever, and how
          much of it got built is read off the project&rsquo;s real line count.
          A village with a fire burning in the middle of it is one I&rsquo;d
          point you at first; a village behind a wall is one whose source
          isn&rsquo;t mine to hand over. Everything else is just the evening.
        </p>
        <div class="about-actions">
          <a class="btn primary" href="mailto:codemanethan@gmail.com">
            codemanethan@gmail.com
          </a>
          <a class="btn" href="https://github.com/CodeManEthan" target="_blank" rel="noopener">
            github.com/CodeManEthan
          </a>
          <a class="btn" href="/days/">The days before &rarr;</a>
        </div>
      </section>
    </main>

    <footer>
      <p>© {new Date().getFullYear()} Ethan · Built with Astro, React &amp; a 2D canvas</p>
    </footer>

    <script type="application/json" id="charter-data" set:html={JSON.stringify(charters)} />

    <script>
      if (import.meta.env.DEV) {
        // Astro installs React Fast Refresh for islands only, and a hand-mounted
        // component compiled by the same plugin still expects it. Install the
        // standard preamble first, or the module throws on `$RefreshSig$`.
        const Refresh = (await import(/* @vite-ignore */ '/@react-refresh')).default;
        Refresh.injectIntoGlobalHook(window);
        (window as any).$RefreshReg$ = () => {};
        (window as any).$RefreshSig$ = () => (t: unknown) => t;
        (window as any).__vite_plugin_react_preamble_installed__ = true;

        const [{ createRoot }, { createElement }, hero, grid] = await Promise.all([
          import('react-dom/client'),
          import('react'),
          import('@codemanethan/genesis/TheGenesis'),
          import('../../../components/designs/charters/CharterGrid'),
        ]);

        createRoot(document.getElementById('hero-root')!).render(
          createElement(hero.default, { embed: true })
        );

        const charters = JSON.parse(document.getElementById('charter-data')!.textContent!);
        createRoot(document.getElementById('charters-root')!).render(
          createElement(grid.default, { charters })
        );
      }
    </script>
  </body>
</html>

<style is:global>
  /* The island's own chrome is React markup, so reaching it needs a global
     rule. The page's top bar owns the first strip of the hero; the island's
     corner column starts underneath it rather than fighting the nav. */
  .gen-embed .gen-corner {
    top: 3.6rem;
  }

  @media (max-width: 820px) {
    .gen-embed .gen-corner {
      top: 10px;
    }
  }

  /* The cards are React markup too, so the palette has to be reachable from
     outside this file's scope. Same values as the homepage. */
  :root {
    --cream: #fdf8ef;
    --card: #ffffff;
    --ink: #413a55;
    --ink-soft: #7a7690;
    --border: #ece3d2;
    --mint: #63c9a8;
  }

  * {
    box-sizing: border-box;
  }
</style>

<style>
  html {
    scroll-behavior: smooth;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }

  body {
    margin: 0;
    background: var(--cream);
    color: var(--ink);
    font-family:
      system-ui,
      -apple-system,
      'Segoe UI',
      Roboto,
      'Helvetica Neue',
      sans-serif;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .skip {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 20;
    padding: 0.6rem 1rem;
    background: var(--mint);
    color: #12483a;
    font-weight: 800;
    border-radius: 0 0 8px 0;
  }

  .skip:focus {
    left: 0;
  }

  /* ------------------------------- top bar ------------------------------ */

  .topbar {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 8;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.9rem clamp(0.9rem, 3vw, 2.4rem);
    background: linear-gradient(180deg, rgba(253, 248, 239, 0.92), rgba(253, 248, 239, 0));
  }

  .wordmark {
    font-weight: 800;
    font-size: 1.05rem;
  }

  .topbar nav {
    display: flex;
    gap: 1.2rem;
  }

  .topbar nav a {
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--ink-soft);
    transition: color 0.15s ease;
  }

  .topbar nav a:hover {
    color: var(--ink);
  }

  /* --------------------------------- hero ------------------------------- */

  .hero {
    position: relative;
    min-height: 100svh;
    overflow: hidden;
    background: #3f7f66;
  }

  .hero-scene {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .intro {
    margin-bottom: 3.2rem;
  }

  .kicker {
    margin: 0 0 0.28rem;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #2f8f74;
  }

  h1 {
    margin: 0 0 0.55rem;
    font-size: clamp(2rem, 4.4vw, 2.7rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .lead {
    margin: 0 0 1.2rem;
    max-width: 44rem;
    color: #5c5877;
    font-size: 1.05rem;
  }

  .intro-actions,
  .about-actions {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-block;
    padding: 0.45rem 1rem;
    border-radius: 999px;
    font-weight: 700;
    font-size: 0.87rem;
    border: 2px solid var(--ink);
    background: #ffffff;
    color: var(--ink);
    transition:
      transform 0.14s ease,
      box-shadow 0.14s ease;
    box-shadow: 0 3px 0 rgba(65, 58, 85, 0.25);
  }

  .btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 5px 0 rgba(65, 58, 85, 0.25);
  }

  .btn.primary {
    background: var(--mint);
    color: #12483a;
  }

  @media (max-width: 820px) {
    .hero {
      min-height: 0;
      padding-top: 3.5rem;
      background: var(--cream);
    }

    .hero-scene {
      position: relative;
      inset: auto;
      height: 48svh;
      min-height: 330px;
    }

    .lead {
      font-size: 0.95rem;
    }

    .noscript {
      position: static;
      padding: 2rem 1rem;
      color: var(--ink-soft);
    }

    .topbar {
      padding: 0.7rem 0.8rem;
    }

    .topbar nav {
      gap: 0.8rem;
      font-size: 0.82rem;
    }
  }

  @media (max-width: 430px) {
    .wordmark {
      font-size: 0.92rem;
    }

    .topbar nav {
      gap: 0.6rem;
      font-size: 0.76rem;
    }
  }

  .noscript {
    position: absolute;
    inset: auto 0 40% 0;
    z-index: 5;
    text-align: center;
    color: #fffdf6;
  }

  /* -------------------------------- main -------------------------------- */

  main {
    max-width: 68rem;
    margin: 0 auto;
    padding: 4.2rem 1.4rem 2rem;
  }

  h2 {
    margin: 0 0 0.5rem;
    font-size: clamp(1.5rem, 3vw, 2rem);
    letter-spacing: -0.01em;
  }

  .section-sub {
    margin: 0 0 2rem;
    max-width: 46rem;
    color: var(--ink-soft);
  }

  .noscript-note {
    margin: 0 0 1rem;
    color: var(--ink-soft);
  }

  .plain {
    margin: 0;
    padding-left: 1.1rem;
    color: var(--ink-soft);
  }

  .plain a {
    font-weight: 700;
    color: var(--ink);
    text-decoration: underline;
  }

  .plain-loc {
    font-weight: 600;
  }

  /* -------------------------------- about ------------------------------- */

  .about {
    margin-top: 4.5rem;
    max-width: 46rem;
  }

  .about p {
    color: var(--ink-soft);
    margin: 0 0 1rem;
  }

  footer {
    border-top: 2px solid var(--border);
    margin-top: 4rem;
    padding: 1.5rem 1.4rem 2.2rem;
    text-align: center;
    color: var(--ink-soft);
    font-size: 0.85rem;
  }

  footer p {
    margin: 0;
  }
</style>
