---
/**
 * Design lab — "The Long Road". DEV ONLY.
 *
 * A candidate homepage: the valley stays on top as weather, and the work below
 * it becomes a road. Seven bands, one project to a band, one road running the
 * full width of every one of them, and a carved plaque planted in the open
 * half of each band.
 *
 * Fenced off exactly as /catalog is, and for the same two reasons:
 *
 *  1. `getStaticPaths` hands back one path under `astro dev` and none at all
 *     in a build, so the page is never emitted.
 *  2. Both React islands are mounted by hand from an `import.meta.env.DEV`
 *     branch rather than with `client:only`. Vite folds that flag to `false`
 *     in a build and drops the branch, so no bundle is emitted either — a
 *     `client:only` import would have left orphan chunks in dist/_astro.
 */
import { getCollection } from 'astro:content';
import { GEM_COLORS, LOC } from '../../../data/islands';

export function getStaticPaths() {
  return import.meta.env.DEV ? [{ params: { slug: undefined } }] : [];
}

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

/** Exactly what the strip needs, and nothing the page has not already got. */
const roadData = projects.map((p, i) => ({
  slug: p.id,
  title: p.data.title,
  summary: p.data.summary,
  tech: p.data.tech,
  status: p.data.status,
  featured: p.data.featured,
  loc: LOC[p.id] ?? 0,
  gem: GEM_COLORS[i % GEM_COLORS.length],
  href: `/projects/${p.id}/`,
  repo: p.data.repo,
  demo: p.data.demo,
}));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>The Long Road — design lab</title>
    <!--
      One inline stylesheet, and `is:inline` on purpose. Astro hands a
      processed <style> to Vite, which emits it as a chunk in dist/_astro even
      for a page that builds no routes — an orphan stylesheet exactly like the
      orphan script a `client:only` island would have left. `is:inline` is
      passed through verbatim and never enters the bundle, so this page really
      does emit nothing.
    -->
    <style is:inline>
      /* --------------------------- page chrome ---------------------------- */
      :root {
        --cream: #fdf8ef;
        --ink: #413a55;
        --ink-soft: #7a7690;
        --border: #ece3d2;
        --mint: #63c9a8;
        --road-edge: #b98b5f;
      }

      html {
        scroll-behavior: smooth;
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
      }

      body {
        margin: 0;
        background: var(--cream);
        color: var(--ink);
        font-family:
          system-ui,
          -apple-system,
          'Segoe UI',
          Roboto,
          'Helvetica Neue',
          sans-serif;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      .skip {
        position: absolute;
        left: -9999px;
        top: 0;
        z-index: 20;
        padding: 0.6rem 1rem;
        background: var(--mint);
        color: #12483a;
        font-weight: 800;
        border-radius: 0 0 8px 0;
      }

      .skip:focus {
        left: 0;
      }

      .topbar {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        z-index: 8;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 0.9rem clamp(0.9rem, 3vw, 2.4rem);
        background: linear-gradient(180deg, rgba(253, 248, 239, 0.92), rgba(253, 248, 239, 0));
      }

      .wordmark {
        font-weight: 800;
        font-size: 1.05rem;
      }

      .topbar nav {
        display: flex;
        gap: 1.2rem;
      }

      .topbar nav a {
        font-weight: 700;
        font-size: 0.9rem;
        color: var(--ink-soft);
        transition: color 0.15s ease;
      }

      .topbar nav a:hover {
        color: var(--ink);
      }

      .hero {
        position: relative;
        min-height: 100svh;
        overflow: hidden;
        background: #3f7f66;
      }

      .hero-scene {
        position: absolute;
        inset: 0;
        z-index: 1;
      }

      .noscript {
        position: absolute;
        inset: auto 0 40% 0;
        z-index: 5;
        text-align: center;
        color: #fffdf6;
      }

      /* `main` is full-bleed so the road can run edge to edge; everything that is
         prose sits in a `.wrap` column inside it. */
      main {
        padding: 4.2rem 0 2rem;
      }

      .wrap {
        max-width: 68rem;
        margin: 0 auto;
        padding-left: 1.4rem;
        padding-right: 1.4rem;
      }

      .intro {
        margin-bottom: 2.6rem;
      }

      .kicker {
        margin: 0 0 0.28rem;
        font-size: 0.68rem;
        font-weight: 800;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: #2f8f74;
      }

      h1 {
        margin: 0 0 0.55rem;
        font-size: clamp(2rem, 4.4vw, 2.7rem);
        line-height: 1.1;
        letter-spacing: -0.02em;
      }

      .lead {
        margin: 0 0 1.2rem;
        max-width: 44rem;
        color: #5c5877;
        font-size: 1.05rem;
      }

      .intro-actions,
      .about-actions {
        display: flex;
        gap: 0.6rem;
        flex-wrap: wrap;
      }

      .btn {
        display: inline-block;
        padding: 0.45rem 1rem;
        border-radius: 999px;
        font-weight: 700;
        font-size: 0.87rem;
        border: 2px solid var(--ink);
        background: #ffffff;
        color: var(--ink);
        transition:
          transform 0.14s ease,
          box-shadow 0.14s ease;
        box-shadow: 0 3px 0 rgba(65, 58, 85, 0.25);
      }

      .btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 0 rgba(65, 58, 85, 0.25);
      }

      .btn.primary {
        background: var(--mint);
        color: #12483a;
      }

      h2 {
        margin: 0 0 0.5rem;
        font-size: clamp(1.5rem, 3vw, 2rem);
        letter-spacing: -0.01em;
      }

      .section-sub {
        margin: 0 0 1.6rem;
        max-width: 46rem;
        color: var(--ink-soft);
      }

      /* ---------------------------- the road band ---------------------------- */

      .road-section {
        margin: 0;
      }

      .road-foot {
        margin: 1.1rem auto 0;
        font-size: 0.85rem;
        color: var(--ink-soft);
      }

      .plain-list {
        padding-top: 1rem;
        padding-bottom: 1rem;
        color: var(--ink-soft);
      }

      .about {
        margin-top: 3.4rem;
      }

      .about p {
        color: var(--ink-soft);
        margin: 0 0 1rem;
        max-width: 46rem;
      }

      footer {
        border-top: 2px solid var(--border);
        margin-top: 2rem;
        padding: 1.5rem 1.4rem 2.2rem;
        text-align: center;
        color: var(--ink-soft);
        font-size: 0.85rem;
      }

      footer p {
        margin: 0;
      }

      @media (max-width: 820px) {
        .hero {
          min-height: 0;
          padding-top: 3.5rem;
          background: var(--cream);
        }

        .hero-scene {
          position: relative;
          inset: auto;
          height: 48svh;
          min-height: 330px;
        }

        .lead {
          font-size: 0.95rem;
        }

        main {
          padding: 2.6rem 0 1.4rem;
        }
      }

      /* The island's own chrome is React markup, so reaching it needs a global
         rule. The page's top bar owns the first strip of the hero. */
      .gen-embed .gen-corner {
        top: 3.6rem;
      }

      @media (max-width: 820px) {
        .gen-embed .gen-corner {
          top: 10px;
        }
      }

      /* ------------------------------- the road ------------------------------ */
      /* The strip is React markup too, so every rule below has to be global. */

      .lr-road {
        position: relative;
        width: 100%;
        border-top: 2px solid var(--road-edge);
        border-bottom: 2px solid var(--road-edge);
        background: #8ed09f;
      }

      .lr-band {
        position: relative;
        width: 100%;
        overflow: hidden;
        /* The seam between two lengths of the same road: a hairline, not a gap. */
        box-shadow: inset 0 -1px 0 rgba(65, 58, 85, 0.16);
      }

      .lr-band:last-child {
        box-shadow: none;
      }

      .lr-canvas {
        position: absolute;
        top: 0;
        left: 0;
        display: block;
        image-rendering: pixelated;
      }

      .lr-hit {
        position: absolute;
        z-index: 2;
        display: block;
        border-radius: 6px;
      }

      /* --------------------------- the carved plaque ------------------------- */

      .lr-plaque {
        position: absolute;
        z-index: 3;
        top: 50%;
        transform: translateY(-50%);
        width: min(38%, 27rem);
      }

      .lr-left .lr-plaque {
        right: clamp(0.9rem, 4vw, 3.4rem);
      }

      .lr-right .lr-plaque {
        left: clamp(0.9rem, 4vw, 3.4rem);
      }

      /* A board of three planks with the post shadow under it. The steps in the
         box-shadow are the same trick the sprites use: no blur, whole pixels. */
      .lr-board {
        position: relative;
        padding: 0.85rem 1.05rem 0.9rem;
        background:
          linear-gradient(
            180deg,
            rgba(255, 255, 255, 0.5) 0%,
            rgba(255, 255, 255, 0) 34%,
            rgba(0, 0, 0, 0.05) 100%
          ),
          #f6ecd8;
        border: 2px solid #8a6340;
        border-radius: 4px;
        box-shadow:
          0 0 0 2px #d8b688,
          0 4px 0 0 #8a6340,
          0 10px 22px rgba(65, 58, 85, 0.28);
      }

      .lr-board::before,
      .lr-board::after {
        /* Two posts holding the board off the grass. */
        content: '';
        position: absolute;
        bottom: -1.15rem;
        width: 8px;
        height: 1.2rem;
        background: linear-gradient(90deg, #b3855b 0 4px, #8a6340 4px 8px);
        z-index: -1;
      }

      .lr-board::before {
        left: 14%;
      }

      .lr-board::after {
        right: 14%;
      }

      .lr-head {
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }

      .lr-leg {
        flex: none;
        display: grid;
        place-items: center;
        min-width: 1.55rem;
        height: 1.55rem;
        padding: 0 0.25rem;
        border-radius: 4px;
        background: var(--gem);
        color: #2c2740;
        font-size: 0.7rem;
        font-weight: 800;
        letter-spacing: 0.04em;
        box-shadow: inset 0 -2px 0 rgba(65, 58, 85, 0.22);
      }

      .lr-band h3 {
        margin: 0;
        font-size: 1.12rem;
        letter-spacing: -0.01em;
      }

      .lr-band h3 a {
        color: #413a55;
      }

      .lr-band h3 a:hover,
      .lr-band.is-hot h3 a {
        color: color-mix(in srgb, var(--gem) 62%, #413a55);
      }

      .lr-beacon {
        margin-left: auto;
        flex: none;
        font-size: 0.6rem;
        font-weight: 800;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: #a2601f;
        padding: 0.1rem 0.4rem;
        border-radius: 999px;
        background: #ffe9bf;
        box-shadow: inset 0 0 0 1px #e8bf7c;
      }

      .lr-place {
        margin: 0.15rem 0 0.4rem;
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 0.09em;
        text-transform: uppercase;
        color: color-mix(in srgb, var(--gem) 55%, #6a6480);
      }

      .lr-summary {
        margin: 0 0 0.55rem;
        font-size: 0.85rem;
        line-height: 1.45;
        color: #5c5877;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }

      .lr-tech {
        display: flex;
        flex-wrap: wrap;
        gap: 0.28rem;
        margin: 0 0 0.6rem;
        padding: 0;
        list-style: none;
      }

      .lr-tech li {
        font-size: 0.68rem;
        padding: 0.05rem 0.45rem;
        border-radius: 3px;
        background: #ece0c8;
        color: #6a6480;
        cursor: help;
      }

      .lr-foot {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.75rem;
        font-size: 0.8rem;
      }

      .lr-more {
        font-weight: 800;
        color: color-mix(in srgb, var(--gem) 68%, #413a55);
      }

      .lr-link {
        color: #7a7690;
        font-weight: 600;
      }

      .lr-more:hover,
      .lr-link:hover {
        text-decoration: underline;
      }

      .lr-status {
        margin: 0.5rem 0 0;
        padding-top: 0.45rem;
        border-top: 1px dashed #ddcdae;
        font-size: 0.7rem;
        letter-spacing: 0.02em;
        color: #8b8399;
      }

      @media (max-width: 820px) {
        .lr-plaque {
          position: static;
          transform: none;
          width: auto;
          margin: 0;
        }

        .lr-band {
          height: auto !important;
          overflow: visible;
          padding-bottom: 1rem;
        }

        .lr-band .lr-canvas {
          position: relative;
        }

        .lr-hit {
          display: none;
        }

        .lr-board {
          margin: -2.2rem clamp(0.6rem, 4vw, 1.4rem) 0;
        }
      }
    </style>
  </head>
  <body>
    <a class="skip" href="#projects">Skip to the project list</a>

    <header class="topbar">
      <a class="wordmark" href="/">CodeManEthan</a>
      <nav>
        <a href="#projects">Projects</a>
        <a href="#about">About</a>
        <a href="https://github.com/CodeManEthan" target="_blank" rel="noopener">GitHub</a>
      </nav>
    </header>

    <section class="hero" aria-label="Today's valley — a pixel-art world generated from the date">
      <div class="hero-scene" id="hero-root"></div>
      <noscript>
        <div class="noscript">
          <p>
            The valley is generated in the browser and needs JavaScript. Every
            project is listed in plain form below.
          </p>
        </div>
      </noscript>
    </section>

    <main>
      <section class="intro wrap" aria-label="Introduction">
        <p class="kicker">Nashville, TN</p>
        <h1>Hi, I&rsquo;m Ethan &mdash; software engineer.</h1>
        <p class="lead">
          I build software end to end &mdash; from a 68k-line personal finance
          platform to the agent infrastructure that lets LLMs do real work.
          Seven projects below, counting the valley above: this site generates a
          new world from scratch every day, from nothing but the date.
        </p>
        <div class="intro-actions">
          <a class="btn primary" href="#projects">Take the road &darr;</a>
          <a class="btn" href="#about">How the valley works</a>
        </div>
      </section>

      <section id="projects" class="road-section">
        <div class="wrap">
          <h2>Seven villages on one road</h2>
          <p class="section-sub">
            The valley up there is weather &mdash; its towns name themselves and
            none of them stand for anything. This is the map. One road, seven
            stops, in the order I would walk you through them: the lines of code
            decide whether a place is a market town or a hamlet, the stack
            decides which trades it keeps, and a lit beacon means I would show
            you that one first. Walk into any of them.
          </p>
        </div>

        <div id="road-root"></div>

        <noscript>
          <ul class="plain-list wrap">
            {
              projects.map((p) => (
                <li>
                  <a href={`/projects/${p.id}/`}>{p.data.title}</a> &mdash; {p.data.summary}
                </li>
              ))
            }
          </ul>
        </noscript>

        <p class="road-foot wrap">
          Every village is seeded from its project&rsquo;s name, never from the
          date, so a place looks the same today as it will next spring &mdash;
          only the leaves turn with the valley above.
        </p>
      </section>

      <section id="about" class="about wrap">
        <h2>A day is just a seed and a date</h2>
        <p>
          I&rsquo;m Ethan — a software engineer in Nashville, TN. I work across
          the stack: Python and Flask on the backend, React and TypeScript on
          the front, Bash and desktop automation where it counts. Lately my
          focus is agentic engineering — the durable plumbing that lets AI
          agents talk to each other and get real work done.
        </p>
        <p>
          The valley is not stored anywhere. Today&rsquo;s date is hashed into a
          seed, the seed generates the terrain, the river, the roads and every
          building the day will contain, and a timeline paces that build across
          twenty-four hours. Nothing is downloaded and nothing is remembered:
          give the same date to any browser on earth and you get the same valley,
          at the same hour, down to the cart on the bridge.
        </p>
        <p>
          The road below it is the opposite kind of thing, and deliberately so.
          It never changes: each village is hashed out of its project&rsquo;s
          own name, so the shape of a place means something and keeps meaning it.
          A town&rsquo;s size is its line count. Its roofs are its colour on
          every other page of this site. Its walls, gates and scaffolding are
          whether you can read the source. Its trades are its stack — hover a
          chip and it will tell you which building it built.
        </p>
        <div class="about-actions">
          <a class="btn primary" href="mailto:codemanethan@gmail.com">
            codemanethan@gmail.com
          </a>
          <a class="btn" href="https://github.com/CodeManEthan" target="_blank" rel="noopener">
            github.com/CodeManEthan
          </a>
          <a class="btn" href="/days/">The days before &rarr;</a>
        </div>
      </section>
    </main>

    <footer>
      <p>© {new Date().getFullYear()} Ethan · Built with Astro, React &amp; a 2D canvas</p>
    </footer>

    <script id="lr-data" type="application/json" is:inline set:html={JSON.stringify(roadData)}
    ></script>

    <script>
      if (import.meta.env.DEV) {
        // Astro installs React Fast Refresh for islands only, and a hand-mounted
        // component compiled by the same plugin still expects it. Install the
        // standard preamble first, or the module throws on `$RefreshSig$`.
        const Refresh = (await import(/* @vite-ignore */ '/@react-refresh')).default;
        Refresh.injectIntoGlobalHook(window);
        (window as any).$RefreshReg$ = () => {};
        (window as any).$RefreshSig$ = () => (t: unknown) => t;
        (window as any).__vite_plugin_react_preamble_installed__ = true;

        const [{ createRoot }, { createElement }, genesis, road] = await Promise.all([
          import('react-dom/client'),
          import('react'),
          import('../../../components/designs/genesis/TheGenesis'),
          import('../../../components/designs/longroad/LongRoad'),
        ]);

        const hero = document.getElementById('hero-root');
        if (hero) createRoot(hero).render(createElement(genesis.default, { embed: true }));

        const raw = document.getElementById('lr-data')?.textContent ?? '[]';
        const mount = document.getElementById('road-root');
        if (mount) {
          createRoot(mount).render(createElement(road.default, { projects: JSON.parse(raw) }));
        }
      }
    </script>
  </body>
</html>
