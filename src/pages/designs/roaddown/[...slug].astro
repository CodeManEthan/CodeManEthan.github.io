---
/**
 * The Road Down the Page — DEV ONLY design prototype.
 *
 * Fenced exactly like /catalog:
 *
 *  1. `getStaticPaths` hands back one path under `astro dev` and none at all in
 *     a build. Zero paths means the page is never emitted.
 *  2. Every client module is pulled in from an `import.meta.env.DEV` branch
 *     rather than with `client:only`. Vite folds that flag to `false` in a
 *     build and drops the branch, so neither the Genesis island nor the road
 *     renderer leaves an orphan chunk in dist/_astro.
 *
 * The shape of the page: the hero is the Genesis valley, and everything below
 * it is *one continuous world* — a single pixel road running from the valley's
 * bottom edge, past seven villages, to the sea at the footer. The world is
 * painted onto a stack of full-bleed canvas tiles behind the page; the words
 * are ordinary HTML floating on top, so the projects stay readable and
 * clickable with no JavaScript at all.
 */
import { getCollection } from 'astro:content';
import { LOC, GEM_COLORS, fmtLoc } from '../../../data/islands';
import { villageSizeLabel } from '../../../components/designs/roaddown/meta';

export function getStaticPaths() {
  return import.meta.env.DEV ? [{ params: { slug: undefined } }] : [];
}

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

/** Everything the road renderer needs to know, handed over as JSON. */
const worldData = projects.map((p, i) => ({
  slug: p.id,
  title: p.data.title,
  loc: LOC[p.id] ?? 0,
  gem: GEM_COLORS[i % GEM_COLORS.length],
  status: p.data.status,
  featured: p.data.featured,
  tech: p.data.tech,
}));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta
      name="description"
      content="Ethan — software engineer in Nashville, TN. Seven projects, strung along one road that runs from the valley to the sea."
    />
    <title>The Road Down the Page — design lab</title>
  </head>
  <body>
    <a class="skip" href="#projects">Skip to the project list</a>

    <header class="topbar">
      <a class="wordmark" href="/">CodeManEthan</a>
      <nav>
        <a href="#projects">Projects</a>
        <a href="#about">About</a>
        <a href="https://github.com/CodeManEthan" target="_blank" rel="noopener">GitHub</a>
      </nav>
    </header>

    <section class="hero" aria-label="Today's valley — a pixel-art world generated from the date">
      <div class="hero-scene"><div id="roaddown-hero"></div></div>
      <noscript>
        <div class="noscript">
          <p>
            The valley and the road are drawn in the browser and need
            JavaScript. Every project is listed in plain form below.
          </p>
        </div>
      </noscript>
    </section>

    <!-- ===================== the road ===================== -->
    <div class="road" id="road">
      <!-- The world. Tiles are appended here by the renderer; with no JS this
           layer stays empty and the page is simply cards on grass. -->
      <div class="road-world" id="road-world" aria-hidden="true"></div>

      <div class="road-rows">
        <section class="milestone intro">
          <div class="card intro-card">
            <p class="kicker">Nashville, TN</p>
            <h1>Hi, I&rsquo;m Ethan &mdash; software engineer.</h1>
            <p class="lead">
              I build software end to end &mdash; from a 68k-line personal
              finance platform to the agent infrastructure that lets LLMs do
              real work. The road out of the valley runs past seven of them and
              ends at the sea. Follow it down.
            </p>
            <div class="actions">
              <a class="btn primary" href="#projects">Take the road &darr;</a>
              <a class="btn" href="#about">Where it ends</a>
            </div>
          </div>
        </section>

        <h2 id="projects" class="road-heading">
          <span>Seven villages, one road</span>
        </h2>

        <ol class="villages">
          {
            projects.map((p, i) => {
              const loc = LOC[p.id];
              const gem = GEM_COLORS[i % GEM_COLORS.length];
              const side = i % 2 === 0 ? 'art-left' : 'art-right';
              return (
                <li
                  class={`village ${side}${p.data.featured ? ' featured' : ''}`}
                  style={`--gem: ${gem}`}
                  data-slug={p.id}
                  data-index={i}
                >
                  <a
                    class="village-slot"
                    href={`/projects/${p.id}/`}
                    tabindex="-1"
                    aria-hidden="true"
                  >
                    <span class="slot-inner" />
                  </a>

                  <div class="card village-card">
                    <p class="village-meta">
                      <span class="milepost">{String(i + 1).padStart(2, '0')}</span>
                      <span class="size">{villageSizeLabel(loc ?? 0)}</span>
                      {p.data.featured && <span class="beacon">beacon lit</span>}
                    </p>
                    <h3>
                      <a href={`/projects/${p.id}/`}>{p.data.title}</a>
                    </h3>
                    <p class="summary">{p.data.summary}</p>
                    {loc && (
                      <p class="size-line">
                        {`${fmtLoc(loc)} lines`}
                        <span class="dot">·</span>
                        {p.data.status === 'public'
                          ? 'gates open'
                          : p.data.status === 'private'
                            ? 'walled, gatehouse manned'
                            : 'still under scaffolding'}
                      </p>
                    )}
                    <ul class="tech">
                      {p.data.tech.map((t) => (
                        <li>{t}</li>
                      ))}
                    </ul>
                    <div class="card-links">
                      <a class="more" href={`/projects/${p.id}/`}>
                        View project →
                      </a>
                      {p.data.status === 'public' && p.data.repo && (
                        <a class="repo" href={p.data.repo} target="_blank" rel="noopener">
                          Source ↗
                        </a>
                      )}
                      {p.data.status === 'private' && (
                        <span class="status">Source private · demo on request</span>
                      )}
                      {p.data.status === 'soon' && <span class="status">Repo coming soon</span>}
                      {p.data.demo && (
                        <a class="repo" href={p.data.demo} target="_blank" rel="noopener">
                          Live demo ↗
                        </a>
                      )}
                    </div>
                  </div>
                </li>
              );
            })
          }
        </ol>

        <section class="milestone shore" id="about">
          <div class="card shore-card">
            <p class="kicker sea">The road runs out</p>
            <h2>A day is just a seed and a date</h2>
            <p>
              I&rsquo;m Ethan — a software engineer in Nashville, TN. I work
              across the stack: Python and Flask on the backend, React and
              TypeScript on the front, Bash and desktop automation where it
              counts. Lately my focus is agentic engineering — the durable
              plumbing that lets AI agents talk to each other and get real work
              done.
            </p>
            <p>
              The valley at the top of this page is not stored anywhere.
              Today&rsquo;s date is hashed into a seed, the seed generates the
              terrain, the river, the roads and every building the day will
              contain, and a timeline paces that build across twenty-four hours.
              Give the same date to any browser on earth and you get the same
              valley, at the same hour, down to the cart on the bridge.
            </p>
            <p>
              The villages on this road are the other half of that idea, turned
              around. They are not weather: each one is seeded from a
              project&rsquo;s own name, so it is the same village every day, and
              its size is the real line count of the repo behind it. Genesis is
              a market town. The little notification fan-out is a hamlet.
            </p>
            <div class="actions">
              <a class="btn primary" href="mailto:codemanethan@gmail.com">
                codemanethan@gmail.com
              </a>
              <a class="btn" href="https://github.com/CodeManEthan" target="_blank" rel="noopener">
                github.com/CodeManEthan
              </a>
              <a class="btn" href="/days/">The days before &rarr;</a>
            </div>
          </div>
        </section>

        <footer>
          <p id="caravan-note" class="caravan-note"></p>
          <p>© {new Date().getFullYear()} Ethan · Built with Astro, React &amp; a 2D canvas</p>
        </footer>
      </div>
    </div>

    <script type="application/json" id="roaddown-data" set:html={JSON.stringify(worldData)} />

    <script>
      if (import.meta.env.DEV) {
        // Astro installs React Fast Refresh for islands only, and a hand-mounted
        // component compiled by the same plugin still expects it. Install the
        // standard preamble first, or the module throws on `$RefreshSig$`.
        const Refresh = (await import(/* @vite-ignore */ '/@react-refresh')).default;
        Refresh.injectIntoGlobalHook(window);
        (window as any).$RefreshReg$ = () => {};
        (window as any).$RefreshSig$ = () => (t: unknown) => t;
        (window as any).__vite_plugin_react_preamble_installed__ = true;

        const [{ createRoot }, { createElement }, genesis, road] = await Promise.all([
          import('react-dom/client'),
          import('react'),
          import('../../../components/designs/genesis/TheGenesis'),
          import('../../../components/designs/roaddown/mount'),
        ]);

        const heroRoot = document.getElementById('roaddown-hero')!;
        createRoot(heroRoot).render(createElement(genesis.default, { embed: true }));

        road.mountRoad();
      }
    </script>

    <style is:global>
      /* The valley's own chrome is React markup, so reaching it needs a global
         rule — the page's top bar owns the first strip of the hero. */
      .gen-embed .gen-corner {
        top: 3.6rem;
      }

      @media (max-width: 820px) {
        .gen-embed .gen-corner {
          top: 10px;
        }
      }
    </style>

    <style>
      :root {
        --cream: #fdf8ef;
        --ink: #35304a;
        --ink-soft: #6f6b87;
        --border: #d9cdb4;
        --mint: #63c9a8;
        /* Kept in step with GRASS in components/designs/roaddown/palette.ts —
           any strip of page the canvas has not reached is still meadow. */
        --grass: #6f9f5a;
        --road-col: 168px;
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
        background: var(--grass);
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
      }

      body {
        margin: 0;
        background: var(--grass);
        color: var(--ink);
        font-family:
          system-ui,
          -apple-system,
          'Segoe UI',
          Roboto,
          'Helvetica Neue',
          sans-serif;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      .skip {
        position: absolute;
        left: -9999px;
        top: 0;
        z-index: 20;
        padding: 0.6rem 1rem;
        background: var(--mint);
        color: #12483a;
        font-weight: 800;
        border-radius: 0 0 8px 0;
      }

      .skip:focus {
        left: 0;
      }

      /* ------------------------------ top bar ----------------------------- */

      .topbar {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        z-index: 8;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 0.9rem clamp(0.9rem, 3vw, 2.4rem);
        background: linear-gradient(180deg, rgba(253, 248, 239, 0.92), rgba(253, 248, 239, 0));
      }

      .wordmark {
        font-weight: 800;
        font-size: 1.05rem;
      }

      .topbar nav {
        display: flex;
        gap: 1.2rem;
      }

      .topbar nav a {
        font-weight: 700;
        font-size: 0.9rem;
        color: var(--ink-soft);
        transition: color 0.15s ease;
      }

      .topbar nav a:hover {
        color: var(--ink);
      }

      /* -------------------------------- hero ------------------------------ */

      .hero {
        position: relative;
        min-height: 100svh;
        overflow: hidden;
        background: #3f7f66;
      }

      .hero-scene,
      .hero-scene > div {
        position: absolute;
        inset: 0;
        z-index: 1;
      }

      .noscript {
        position: absolute;
        inset: auto 0 40% 0;
        z-index: 5;
        text-align: center;
        color: #fffdf6;
      }

      /* -------------------------------- road ------------------------------ */

      .road {
        position: relative;
        background: var(--grass);
        /* The valley above ends on its own ground; the road world starts flush
           against it with no seam of page showing through. */
        margin-top: -1px;
      }

      .road-world {
        position: absolute;
        inset: 0;
        z-index: 0;
        overflow: hidden;
        pointer-events: none;
      }

      .road-world canvas {
        display: block;
        width: 100%;
        image-rendering: pixelated;
      }

      .road-rows {
        position: relative;
        z-index: 1;
      }

      /* Every row is the same three-column frame: shoulder, road, shoulder.
         The middle column is the road's own lane and is never written into, so
         the carriageway is clear from the first village to the sea. */
      .milestone,
      .village,
      .road-heading,
      .road-rows > footer {
        display: grid;
        grid-template-columns:
          minmax(0, 1fr) var(--road-col)
          minmax(0, 1fr);
        align-items: center;
        max-width: 1500px;
        margin: 0 auto;
        padding: 0 clamp(0.8rem, 3vw, 2rem);
      }

      .card {
        background: rgba(253, 248, 239, 0.95);
        border: 2px solid var(--border);
        border-radius: 4px;
        padding: 1.3rem 1.45rem;
        box-shadow:
          0 3px 0 rgba(40, 52, 32, 0.22),
          0 14px 30px rgba(30, 44, 24, 0.16);
      }

      /* ---- the first stretch: out of the valley ---- */

      .intro {
        min-height: 74svh;
        padding-top: 4.5rem;
        padding-bottom: 3rem;
      }

      .intro-card {
        grid-column: 1;
        max-width: 34rem;
        justify-self: end;
      }

      .kicker {
        margin: 0 0 0.3rem;
        font-size: 0.68rem;
        font-weight: 800;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: #2f7f4a;
      }

      .kicker.sea {
        color: #2b6f92;
      }

      h1 {
        margin: 0 0 0.55rem;
        font-size: clamp(1.9rem, 4.2vw, 2.6rem);
        line-height: 1.1;
        letter-spacing: -0.02em;
      }

      .lead {
        margin: 0 0 1.2rem;
        color: #57536e;
        font-size: 1.03rem;
      }

      .actions {
        display: flex;
        gap: 0.6rem;
        flex-wrap: wrap;
      }

      .btn {
        display: inline-block;
        padding: 0.45rem 1rem;
        border-radius: 999px;
        font-weight: 700;
        font-size: 0.87rem;
        border: 2px solid var(--ink);
        background: #ffffff;
        color: var(--ink);
        transition:
          transform 0.14s ease,
          box-shadow 0.14s ease;
        box-shadow: 0 3px 0 rgba(53, 48, 74, 0.25);
      }

      .btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 0 rgba(53, 48, 74, 0.25);
      }

      .btn.primary {
        background: var(--mint);
        color: #12483a;
      }

      /* ---- the signpost at the head of the villages ---- */

      .road-heading {
        margin: 0;
        padding-top: 1rem;
        padding-bottom: 2.5rem;
        font-size: clamp(1.3rem, 2.6vw, 1.7rem);
        letter-spacing: -0.01em;
        scroll-margin-top: 2rem;
      }

      .road-heading span {
        grid-column: 1;
        justify-self: end;
        display: inline-block;
        padding: 0.35rem 1rem;
        background: rgba(253, 248, 239, 0.95);
        border: 2px solid var(--border);
        border-radius: 3px;
        box-shadow: 0 3px 0 rgba(40, 52, 32, 0.22);
      }

      /* ---- the villages ---- */

      .villages {
        margin: 0;
        padding: 0;
        list-style: none;
      }

      .village {
        min-height: 460px;
        padding-top: 1rem;
        padding-bottom: 1rem;
      }

      /* Both halves are pinned to row 1 explicitly. Without it, grid's sparse
         auto-placement refuses to go back to an earlier column for an item that
         came later in the DOM, so every art-right village would drop its card
         onto a second row and stand a full slot-height away from its own art. */
      .village-slot,
      .village-card {
        grid-row: 1;
      }

      .village.art-left .village-slot {
        grid-column: 1;
      }

      .village.art-left .village-card {
        grid-column: 3;
        justify-self: start;
      }

      .village.art-right .village-card {
        grid-column: 1;
        justify-self: end;
      }

      .village.art-right .village-slot {
        grid-column: 3;
      }

      /* The art itself lives on the world canvas behind the page. This is the
         hit area sitting exactly over it — the renderer measures this box and
         paints the village into it, so the two can never drift apart. */
      .village-slot {
        display: block;
        width: 100%;
        max-width: 520px;
        aspect-ratio: 16 / 10;
        border-radius: 3px;
        justify-self: center;
      }

      .village.art-left .village-slot {
        justify-self: end;
      }

      .village.art-right .village-slot {
        justify-self: start;
      }

      .village-card {
        max-width: 31rem;
      }

      .village-meta {
        display: flex;
        align-items: center;
        gap: 0.55rem;
        margin: 0 0 0.35rem;
        font-size: 0.68rem;
        font-weight: 800;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--ink-soft);
      }

      .milepost {
        display: inline-grid;
        place-items: center;
        width: 1.5rem;
        height: 1.5rem;
        border-radius: 3px;
        background: var(--gem);
        color: #2c2740;
        letter-spacing: 0;
        font-size: 0.7rem;
      }

      .beacon {
        margin-left: auto;
        color: #b07a1f;
      }

      .beacon::before {
        content: '';
        display: inline-block;
        width: 6px;
        height: 6px;
        margin-right: 0.35rem;
        border-radius: 50%;
        background: #ffca4a;
        box-shadow: 0 0 0 3px rgba(255, 202, 74, 0.32);
        vertical-align: middle;
      }

      .village-card h3 {
        margin: 0 0 0.3rem;
        font-size: 1.28rem;
      }

      .village-card h3 a:hover {
        color: color-mix(in srgb, var(--gem) 70%, var(--ink));
      }

      .summary {
        margin: 0 0 0.5rem;
        color: var(--ink-soft);
        font-size: 0.93rem;
      }

      .size-line {
        margin: 0 0 0.55rem;
        font-size: 0.78rem;
        font-weight: 700;
        color: color-mix(in srgb, var(--gem) 62%, var(--ink));
      }

      .size-line .dot {
        margin: 0 0.4rem;
        opacity: 0.5;
      }

      .tech {
        display: flex;
        flex-wrap: wrap;
        gap: 0.35rem;
        margin: 0 0 0.7rem;
        padding: 0;
        list-style: none;
      }

      .tech li {
        font-size: 0.72rem;
        padding: 0.1rem 0.55rem;
        border: 1px solid var(--border);
        border-radius: 999px;
        color: var(--ink-soft);
      }

      .card-links {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.8rem;
        font-size: 0.85rem;
      }

      .more {
        font-weight: 700;
        color: color-mix(in srgb, var(--gem) 70%, var(--ink));
      }

      .repo {
        color: var(--ink-soft);
        font-weight: 600;
      }

      .status {
        font-size: 0.74rem;
        color: var(--ink-soft);
        border: 1px dashed var(--border);
        border-radius: 999px;
        padding: 0.05rem 0.55rem;
      }

      /* Hovering either half of a village lights the other — the art and the
         words are one target. */
      .village-card,
      .village-slot .slot-inner {
        transition:
          border-color 0.16s ease,
          transform 0.16s ease,
          box-shadow 0.16s ease;
      }

      .village-slot .slot-inner {
        display: block;
        width: 100%;
        height: 100%;
        border: 2px dashed transparent;
        border-radius: 4px;
      }

      .village:hover .slot-inner,
      .village:focus-within .slot-inner {
        border-color: color-mix(in srgb, var(--gem) 70%, transparent);
        background: color-mix(in srgb, var(--gem) 9%, transparent);
      }

      .village:hover .village-card,
      .village:focus-within .village-card {
        border-color: var(--gem);
        transform: translateY(-2px);
        box-shadow:
          0 5px 0 rgba(40, 52, 32, 0.22),
          0 16px 34px rgba(30, 44, 24, 0.18);
      }

      /* ---- the shore ---- */

      .shore {
        min-height: 82svh;
        padding-top: 8rem;
        padding-bottom: 3rem;
        scroll-margin-top: 2rem;
      }

      .shore-card {
        grid-column: 3;
        max-width: 34rem;
        justify-self: start;
      }

      .shore-card h2 {
        margin: 0 0 0.6rem;
        font-size: clamp(1.5rem, 3vw, 2rem);
        letter-spacing: -0.01em;
      }

      .shore-card p {
        margin: 0 0 0.9rem;
        color: var(--ink-soft);
        font-size: 0.95rem;
      }

      .road-rows > footer {
        padding-top: 2rem;
        padding-bottom: 3rem;
        text-align: center;
      }

      .road-rows > footer p {
        grid-column: 1 / -1;
        margin: 0;
        color: #dff0f6;
        font-size: 0.85rem;
        text-shadow: 0 1px 2px rgba(12, 40, 58, 0.55);
      }

      .caravan-note {
        margin-bottom: 0.4rem !important;
        font-weight: 700;
      }

      .caravan-note:empty {
        display: none;
      }

      /* ------------------------------ narrow ------------------------------ */

      @media (max-width: 900px) {
        :root {
          --road-col: 92px;
        }

        .milestone,
        .village,
        .road-heading,
        .road-rows > footer {
          grid-template-columns: var(--road-col) minmax(0, 1fr);
          padding-right: clamp(0.8rem, 4vw, 1.4rem);
        }

        .intro-card,
        .shore-card,
        .road-heading span,
        .village.art-left .village-card,
        .village.art-right .village-card {
          grid-column: 2;
          justify-self: start;
        }

        /* Stacked, so the art goes back to being its own row above the words. */
        .village {
          gap: 0.9rem 0;
        }

        .village-slot,
        .village-card {
          grid-row: auto;
        }

        .village.art-left .village-slot,
        .village.art-right .village-slot {
          grid-column: 2;
          justify-self: start;
          max-width: 420px;
        }

        .village.art-left .village-card,
        .village.art-right .village-card {
          grid-column: 2;
        }

        .hero {
          min-height: 0;
          padding-top: 3.5rem;
          background: var(--cream);
        }

        .hero-scene,
        .hero-scene > div {
          position: relative;
          inset: auto;
          height: 48svh;
          min-height: 330px;
        }

        .noscript {
          position: static;
          padding: 2rem 1rem;
          color: var(--ink-soft);
        }

        .topbar {
          padding: 0.7rem 0.8rem;
        }

        .topbar nav {
          gap: 0.8rem;
