---
import { getCollection } from 'astro:content';
import GalleryScene from '../../components/designs/gallery/GalleryScene';

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order
);

const sceneProjects = projects.map((p) => ({
  id: p.id,
  title: p.data.title,
  summary: p.data.summary,
  tech: p.data.tech,
  featured: p.data.featured,
  status: p.data.status,
}));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Ethan — software engineer & agentic engineer. A 3D gallery flythrough of selected projects."
    />
    <title>Ethan · Software & Agentic Engineer — Gallery Flythrough</title>
  </head>
  <body>
    <header class="top">
      <a class="brand" href="/">CodeManEthan</a>
      <nav>
        <a href="#projects">Projects</a>
        <a href="#about">About</a>
        <a href="https://github.com/CodeManEthan" target="_blank" rel="noopener">GitHub ↗</a>
      </nav>
    </header>

    <section id="flythrough" aria-label="3D project flythrough">
      <a class="skip" href="#projects">Skip to project list ↓</a>
      <GalleryScene client:only="react" projects={sceneProjects} />
      <noscript>
        <div class="noscript-hero">
          <h1 class="gradient-text">Ethan</h1>
          <p>Software &amp; Agentic Engineer</p>
          <a href="#projects">View projects ↓</a>
        </div>
      </noscript>
    </section>

    <main>
      <section id="projects">
        <h2 class="gradient-text">All projects</h2>
        <p class="section-lede">
          Everything from the flythrough, in plain form — every card links to a
          full write-up.
        </p>
        <div class="grid">
          {
            projects.map((project) => {
              const { title, summary, tech, status, repo, demo, featured } = project.data;
              const detailUrl = `/projects/${project.id}/`;
              return (
                <article class="card">
                  <div class="card-head">
                    <h3>
                      <a href={detailUrl}>{title}</a>
                    </h3>
                    {featured && <span class="star" title="Featured">★</span>}
                  </div>
                  <p class="summary">{summary}</p>
                  <ul class="tech-list">
                    {tech.map((t) => (
                      <li>{t}</li>
                    ))}
                  </ul>
                  <div class="card-links">
                    {status === 'public' && repo && (
                      <a href={repo} target="_blank" rel="noopener">
                        Source ↗
                      </a>
                    )}
                    {status === 'private' && (
                      <span class="badge">Source private · demo on request</span>
                    )}
                    {status === 'soon' && <span class="badge">Repo coming soon</span>}
                    {demo && (
                      <a href={demo} target="_blank" rel="noopener">
                        Live demo ↗
                      </a>
                    )}
                    <a href={detailUrl} class="more">
                      Details →
                    </a>
                  </div>
                </article>
              );
            })
          }
        </div>
      </section>

      <section id="about">
        <h2 class="gradient-text">About</h2>
        <p>
          I'm Ethan — a software engineer and agentic engineer. I work across
          the stack: Python and Flask on the backend, React and TypeScript on
          the front, Bash and desktop automation where it counts. Lately my
          focus is agent infrastructure — building the durable plumbing that
          lets AI agents communicate and work reliably.
        </p>
        <p>
          This page is one of my projects too: an Astro site with a React
          island flying a Three.js camera down a spline. Prefer things quieter?
          The list above is the same content, no WebGL required.
        </p>
        <p class="contact">
          <a href="mailto:codemanethan@gmail.com">codemanethan@gmail.com</a>
          <span aria-hidden="true">·</span>
          <a href="https://github.com/CodeManEthan" target="_blank" rel="noopener">github.com/CodeManEthan</a>
        </p>
      </section>
    </main>

    <footer>
      <span>© 2026 Ethan · Built with Astro, React &amp; Three.js</span>
    </footer>
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  astro-island {
    display: contents;
  }

  :root {
    --bg: #0a0616;
    --bg-raised: #151028;
    --text: #ece7fa;
    --text-dim: #a79ec7;
    --border: #2a2148;
    --violet: #a855f7;
    --pink: #ec4899;
    --cyan: #22d3ee;
    --gradient: linear-gradient(90deg, var(--violet), var(--pink), var(--cyan));
  }

  html {
    background: var(--bg);
    color: var(--text);
    font-family:
      system-ui,
      -apple-system,
      'Segoe UI',
      Roboto,
      sans-serif;
    line-height: 1.6;
    scroll-behavior: smooth;
  }

  body {
    min-height: 100vh;
  }

  a {
    color: var(--cyan);
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
  }
</style>

<style>
  .gradient-text {
    background: var(--gradient);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  /* ---------- header + skip ---------- */

  .top {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 30;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.1rem 1.6rem;
    pointer-events: none;
  }

  .top a {
    pointer-events: auto;
  }

  .brand {
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--text);
  }

  .top nav {
    display: flex;
    gap: 1.3rem;
    font-size: 0.92rem;
  }

  .top nav a {
    color: var(--text-dim);
  }

  .top nav a:hover {
    color: var(--cyan);
    text-decoration: none;
  }

  .skip {
    position: absolute;
    bottom: 1.2rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 30;
    font-size: 0.82rem;
    color: var(--text-dim);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.35rem 0.95rem;
    background: color-mix(in srgb, var(--bg) 75%, transparent);
    backdrop-filter: blur(6px);
  }

  .skip:hover {
    color: var(--cyan);
    border-color: var(--cyan);
    text-decoration: none;
  }

  /* ---------- flythrough section ---------- */

  #flythrough {
    position: relative;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
    background:
      radial-gradient(ellipse at 20% 10%, rgba(168, 85, 247, 0.12), transparent 55%),
      radial-gradient(ellipse at 80% 90%, rgba(34, 211, 238, 0.08), transparent 55%),
      var(--bg);
  }

  .noscript-hero {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    text-align: center;
    gap: 0.8rem;
  }

  .noscript-hero h1 {
    font-size: clamp(2.4rem, 7vw, 4rem);
  }

  .noscript-hero p {
    color: var(--text-dim);
    font-size: 1.15rem;
  }

  @media (prefers-reduced-motion: reduce) {
    #flythrough {
      height: auto;
      min-height: 45vh;
    }

    .skip {
      display: none;
    }

    html {
      scroll-behavior: auto;
    }
  }

  /* ---------- main content ---------- */

  main {
    max-width: 68rem;
    margin: 0 auto;
    padding: 4.5rem 1.4rem 2rem;
  }

  h2 {
    display: inline-block;
    font-size: 1.9rem;
    margin-bottom: 0.6rem;
  }

  .section-lede {
    color: var(--text-dim);
    margin-bottom: 2rem;
    max-width: 44rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.4rem;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 1.3rem 1.35rem;
    position: relative;
    transition:
      transform 0.16s ease,
      border-color 0.16s ease,
      box-shadow 0.16s ease;
  }

  .card:hover {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--violet) 55%, var(--border));
    box-shadow: 0 6px 30px rgba(168, 85, 247, 0.15);
  }

  .card-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.6rem;
  }

  .card h3 {
    font-size: 1.18rem;
  }

  .card h3 a {
    color: var(--text);
  }

  .card h3 a:hover {
    color: var(--cyan);
    text-decoration: none;
  }

  .star {
    color: var(--pink);
    font-size: 0.95rem;
  }

  .summary {
    color: var(--text-dim);
    font-size: 0.95rem;
    flex: 1;
  }

  .tech-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
  }

  .tech-list li {
    font-size: 0.76rem;
    padding: 0.14rem 0.6rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: color-mix(in srgb, var(--violet) 75%, white);
    background: rgba(168, 85, 247, 0.08);
  }

  .card-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.9rem;
    font-size: 0.87rem;
    margin-top: 0.2rem;
  }

  .badge {
    color: var(--text-dim);
    font-size: 0.78rem;
    border: 1px dashed var(--border);
    border-radius: 999px;
    padding: 0.12rem 0.65rem;
  }

  .more {
    margin-left: auto;
    color: var(--pink);
  }

  /* ---------- about ---------- */

  #about {
    margin-top: 4.5rem;
    max-width: 46rem;
  }

  #about p {
    color: var(--text-dim);
    margin-bottom: 1rem;
  }

  .contact {
    display: flex;
    gap: 0.7rem;
    flex-wrap: wrap;
    align-items: center;
  }

  /* ---------- footer ---------- */

  footer {
    border-top: 1px solid var(--border);
    margin-top: 3.5rem;
    padding: 1.6rem 1.4rem 2rem;
    text-align: center;
    color: var(--text-dim);
    font-size: 0.85rem;
  }
</style>
