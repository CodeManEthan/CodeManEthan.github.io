---
import fs from 'node:fs';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { title, summary, tech, status, repo, demo, image } = project.data;
const screenshot =
  project.data.screenshot && fs.existsSync(`public${project.data.screenshot}`)
    ? project.data.screenshot
    : undefined;
const art = image ?? screenshot;
const alt = image ? title : `${title} screenshot`;
const isGenesis = project.id === 'genesis';
const { Content } = await render(project);
---

<Base title={`${title} · Ethan Plunk`} description={summary} image={art} type="article">
  <article class="project">
    <a href="/#projects" class="back">← Projects</a>
    <h1>{title}</h1>
    <p class="summary">{summary}</p>
    <div class="meta">
      <ul class="chips" aria-label="Built with">
        {tech.map((t) => <li>{t}</li>)}
      </ul>
      <div class="links">
        {status === 'public' && repo && (
          <a href={repo} target="_blank" rel="noopener">Source</a>
        )}
        {isGenesis ? (
          <a href="/genesis/">Open the valley</a>
        ) : (
          demo && <a href={demo} target="_blank" rel="noopener">Live demo</a>
        )}
        {status === 'private' && <span class="badge">Private</span>}
        {status === 'soon' && <span class="badge">Coming soon</span>}
      </div>
    </div>
    {art && <img class="shot" src={art} alt={alt} width="1600" height="900" />}
    <div class="body">
      <Content />
    </div>
  </article>
</Base>

<style>
  .project {
    max-width: 46rem;
    margin: 2.5rem auto 0;
  }

  .back {
    color: var(--ink-soft);
    font-size: 0.9rem;
    font-weight: 500;
  }

  .back:hover {
    color: var(--ink);
  }

  h1 {
    margin: 1rem 0 0.6rem;
  }

  .summary {
    color: var(--ink-soft);
    font-size: 1.1rem;
    margin-bottom: 1.2rem;
  }

  .meta {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    margin-bottom: 1.6rem;
  }

  .links {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    align-items: center;
    font-weight: 500;
  }

  .badge {
    color: var(--ink-soft);
    font-size: 0.85rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.1rem 0.7rem;
  }

  .shot {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    margin-bottom: 1.6rem;
  }

  .body :global(h2) {
    font-size: 1.4rem;
    margin: 2rem 0 0.8rem;
  }

  .body :global(h3) {
    font-size: 1.15rem;
    margin: 1.5rem 0 0.6rem;
  }

  .body :global(p) {
    margin-bottom: 1rem;
  }

  .body :global(ul),
  .body :global(ol) {
    margin: 0 0 1rem 1.4rem;
  }

  .body :global(li) {
    margin-bottom: 0.35rem;
  }

  .body :global(strong) {
    color: var(--ink);
  }
</style>
