---
import fs from 'node:fs';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { LOC, GEM_COLORS, fmtLoc, sizeLabel } from '../../data/islands';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort(
    (a, b) => a.data.order - b.data.order
  );
  return projects.map((project, index) => ({
    params: { slug: project.id },
    props: { project, accent: GEM_COLORS[index % GEM_COLORS.length] },
  }));
}

const { project, accent } = Astro.props;
const { title, summary, tech, status, repo, demo } = project.data;
// Only render the screenshot if the file actually exists in public/
const screenshot =
  project.data.screenshot && fs.existsSync(`public${project.data.screenshot}`)
    ? project.data.screenshot
    : undefined;
const loc = LOC[project.id];
const { Content } = await render(project);
---

<Base title={`${title} · Ethan`} description={summary} accent={accent}>
  <article class="project">
    <a href="/#projects" class="back">← Back to the valley</a>
    <div class="title-row">
      <span class="gem" aria-hidden="true"></span>
      <h1>{title}</h1>
    </div>
    {loc && (
      <p class="island-line">{fmtLoc(loc)} lines of code · {sizeLabel(loc)}</p>
    )}
    <p class="summary">{summary}</p>
    <div class="meta">
      <ul class="tech-list">
        {tech.map((t) => <li>{t}</li>)}
      </ul>
      <div class="links">
        {status === 'public' && repo && (
          <a href={repo} target="_blank" rel="noopener">Source on GitHub ↗</a>
        )}
        {status === 'private' && <span class="badge">{demo ? 'Source private' : 'Source private · demo on request'}</span>}
        {status === 'soon' && <span class="badge">Repo coming soon</span>}
        {demo && <a href={demo} target="_blank" rel="noopener">Live demo ↗</a>}
      </div>
    </div>
    {screenshot && <img class="shot" src={screenshot} alt={`${title} screenshot`} />}
    <div class="body">
      <Content />
    </div>
  </article>
</Base>

<style>
  .project {
    max-width: 46rem;
    margin: 2.5rem auto 0;
  }

  .back {
    color: var(--ink-soft);
    font-size: 0.9rem;
    font-weight: 600;
  }

  .back:hover {
    color: var(--ink);
    text-decoration: none;
  }

  .title-row {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin: 1rem 0 0.15rem;
  }

  .gem {
    width: 1.05rem;
    height: 1.05rem;
    background: var(--accent);
    border-radius: 4px;
    transform: rotate(45deg);
    flex-shrink: 0;
    box-shadow: 0 2px 8px color-mix(in srgb, var(--accent) 45%, transparent);
  }

  h1 {
    font-size: clamp(1.8rem, 5vw, 2.6rem);
    line-height: 1.2;
  }

  .island-line {
    color: color-mix(in srgb, var(--accent) 70%, var(--ink));
    font-weight: 700;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 0.9rem;
  }

  .summary {
    color: var(--ink-soft);
    font-size: 1.1rem;
    margin-bottom: 1.2rem;
  }

  .meta {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    margin-bottom: 1.6rem;
  }

  .tech-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
  }

  .tech-list li {
    font-size: 0.8rem;
    font-weight: 600;
    padding: 0.18rem 0.65rem;
    border: 1px solid color-mix(in srgb, var(--accent) 35%, var(--border));
    border-radius: 999px;
    color: color-mix(in srgb, var(--accent) 60%, var(--ink));
    background: color-mix(in srgb, var(--accent) 10%, var(--card));
  }

  .links {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    align-items: center;
    font-weight: 600;
  }

  .badge {
    color: var(--ink-soft);
    font-size: 0.85rem;
    border: 1px dashed var(--border);
    border-radius: 999px;
    padding: 0.15rem 0.7rem;
    background: var(--card);
  }

  .shot {
    width: 100%;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    margin-bottom: 1.6rem;
    box-shadow: 0 10px 30px rgba(67, 64, 90, 0.08);
  }

  .body :global(h2) {
    font-size: 1.4rem;
    margin: 2rem 0 0.8rem;
  }

  .body :global(h3) {
    font-size: 1.15rem;
    margin: 1.5rem 0 0.6rem;
  }

  .body :global(p) {
    margin-bottom: 1rem;
  }

  .body :global(ul),
  .body :global(ol) {
    margin: 0 0 1rem 1.4rem;
  }

  .body :global(li) {
    margin-bottom: 0.35rem;
  }

  .body :global(strong) {
    color: color-mix(in srgb, var(--accent) 45%, var(--ink));
  }
</style>
